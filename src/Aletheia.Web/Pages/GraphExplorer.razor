@page "/graph"
@using System.Globalization
@using System.Text.Json
@inject RepositoryApiClient ApiClient
@inject RecentGraphContextService RecentContext
@inject IJSRuntime JS

<PageTitle>Graph Explorer - Aletheia</PageTitle>

<div class="graph-workspace">
    <div class="graph-toolbar">
        <div class="graph-title">
            <h1>Knowledge Graph Explorer</h1>
            @if (_nodes is not null && _edges is not null)
            {
                <span>@_nodes.Count / @(_allNodes?.Count ?? 0) nodes · @_edges.Count / @(_allEdges?.Count ?? 0) edges</span>
            }
        </div>

        <div class="graph-actions">
            <button class="btn btn-outline-primary" @onclick="ImportGraphAsync" disabled="@(_importing || _isLoadingGraph)">
                @(_importing ? "Importing..." : "Import from Ontology")
            </button>
            <button class="btn btn-outline-secondary" @onclick="LoadGraphAsync" disabled="@_isLoadingGraph">Refresh Graph</button>
            <button class="btn btn-outline-secondary" title="Fit graph to window" @onclick="FitGraphAsync" disabled="@_isLoadingGraph">Fit</button>
            <button class="btn btn-outline-secondary" title="Run layout again" @onclick="RelayoutGraphAsync" disabled="@_isLoadingGraph">Re-layout</button>
            <button class="btn btn-outline-secondary" title="Spread nodes farther apart" @onclick="SpreadGraphAsync" disabled="@_isLoadingGraph">Spread</button>

            <div class="graph-zoom" title="Zoom level">
                <label class="form-label" for="graph-zoom-slider">Zoom</label>
                <input id="graph-zoom-slider" class="form-range" type="range" min="25" max="300" step="5"
                       value="@ZoomPercent" @oninput="OnZoomSliderAsync" aria-label="Zoom level" />
                <input id="graph-zoom-factor" class="form-control form-control-sm graph-zoom-factor" type="number"
                       min="0.25" max="3" step="0.05" value="@_zoomFactor" @onchange="OnZoomFactorAsync"
                       aria-label="Scaling factor" />
                <span class="graph-zoom-unit">&times;</span>
            </div>
        </div>

        <div class="path-finder">
            <label class="form-label" for="path-from">From</label>
            <select id="path-from" class="form-select" @bind="_pathFrom">
                <option value="">Select node...</option>
                @if (_nodes is not null)
                {
                    @foreach (var node in _nodes)
                    {
                        <option value="@node.Id">@node.Label</option>
                    }
                }
            </select>

            <label class="form-label" for="path-to">To</label>
            <select id="path-to" class="form-select" @bind="_pathTo">
                <option value="">Select node...</option>
                @if (_nodes is not null)
                {
                    @foreach (var node in _nodes)
                    {
                        <option value="@node.Id">@node.Label</option>
                    }
                }
            </select>

            <button class="btn btn-primary" @onclick="FindPathAsync" disabled="@_isLoadingGraph">Find Path</button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert @(_statusSuccess ? "alert-success" : "alert-danger") graph-message">@_statusMessage</div>
    }

    @if (_pathResult is not null)
    {
        <div class="path-result">
            @if (_pathResult.Count == 0)
            {
                <span>No path found.</span>
            }
            else
            {
                @foreach (var path in _pathResult)
                {
                    <span>@string.Join(" -> ", path.Nodes.Select(n => n.Label))</span>
                }
            }
        </div>
    }

    <div class="graph-main">
        <div class="graph-canvas">
            <div id="graph-container"></div>
            @if (_isLoadingGraph)
            {
                <div class="graph-loading-overlay" role="status" aria-live="polite">
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span>@_graphStatus</span>
                </div>
            }
        </div>

        <aside class="graph-context-panel">
            <div class="context-panel-header">
                <div>
                    <h2>Recent Context</h2>
                    <span>@ContextSummary</span>
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshRecentContextAsync">Refresh</button>
            </div>

            <div class="context-mode">
                <label class="form-check">
                    <input class="form-check-input" type="checkbox" checked="@_showFullGraph" @onchange="ToggleFullGraphAsync" />
                    <span class="form-check-label">Explore full graph</span>
                </label>
                <label class="form-check">
                    <input class="form-check-input" type="checkbox" checked="@_showChunkNodes" @onchange="ToggleChunkNodesAsync" />
                    <span class="form-check-label">Show chunk nodes (technical)</span>
                </label>
                <label class="form-check">
                    <input class="form-check-input" type="checkbox" checked="@_showOrphanNodes" @onchange="ToggleOrphanNodesAsync" />
                    <span class="form-check-label">Show orphan nodes (technical)</span>
                </label>
            </div>

            <div class="context-actions">
                <button class="btn btn-sm btn-outline-primary" @onclick="SelectAllContextAsync" disabled="@(_recentContext.Count == 0)">Select all</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearContextAsync" disabled="@(_selectedContextKeys.Count == 0)">Clear</button>
                <button class="btn btn-sm btn-outline-danger" @onclick="ClearRecentContextListAsync" disabled="@(_recentContext.Count == 0)">Clear list</button>
            </div>

            @if (_recentContext.Count == 0)
            {
                <p class="context-empty">Recent uploads and searches will appear here.</p>
            }
            else
            {
                <div class="context-list">
                    @foreach (var item in _recentContext)
                    {
                        <label class="context-item">
                            <input type="checkbox" checked="@_selectedContextKeys.Contains(item.Key)" @onchange="args => ToggleContextItemAsync(item.Key, args)" disabled="@_showFullGraph" />
                            <span>
                                <strong>@item.Label</strong>
                                <small>@ContextKindLabel(item) · @item.Timestamp.ToLocalTime().ToString("g")</small>
                            </span>
                        </label>
                    }
                </div>
            }
        </aside>
    </div>
</div>

@code {
    private List<GraphNode>? _allNodes;
    private List<GraphEdge>? _allEdges;
    private List<GraphNode>? _nodes;
    private List<GraphEdge>? _edges;
    private List<RecentGraphContextItem> _recentContext = new();
    private HashSet<string> _selectedContextKeys = new(StringComparer.OrdinalIgnoreCase);
    private bool _showFullGraph;
    private bool _showChunkNodes;
    private bool _showOrphanNodes;
    private bool _importing;
    private string _statusMessage = string.Empty;
    private bool _statusSuccess;

    private string _pathFrom = string.Empty;
    private string _pathTo = string.Empty;
    private List<GraphPath>? _pathResult;
    private bool _renderGraphAfterRender;
    private bool _isLoadingGraph;
    private string _graphStatus = string.Empty;
    private bool _graphRendered;
    private DotNetObjectReference<GraphExplorer>? _dotNetRef;
    private double _zoomFactor = 1.0;

    private int ZoomPercent => (int)Math.Round(_zoomFactor * 100);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await LoadRecentContextAsync(render: false);
            await LoadGraphAsync();
        }

        if (_renderGraphAfterRender && _nodes is not null && _edges is not null)
        {
            _renderGraphAfterRender = false;
            await JS.InvokeVoidAsync("initGraph", "graph-container", _nodes, _edges, _dotNetRef, _graphRendered);
            _graphRendered = true;
        }
    }

    private async Task LoadGraphAsync()
    {
        _isLoadingGraph = true;
        _graphStatus = "Loading graph…";
        _statusMessage = string.Empty;
        StateHasChanged();

        try
        {
            _allNodes = await ApiClient.GraphGetNodesAsync();
            _graphStatus = "Loading edges…";
            StateHasChanged();
            _allEdges = await ApiClient.GraphGetEdgesAsync();

            if (_allNodes is null || _allEdges is null)
            {
                _nodes = null;
                _edges = null;
                _statusSuccess = false;
                _statusMessage = "Graph load failed. Refresh the graph or check the API response.";
                _isLoadingGraph = false;
                StateHasChanged();
                return;
            }

            if (_allNodes.Count == 0)
            {
                _statusSuccess = true;
                _statusMessage = "Graph is empty. Import from Ontology to populate it.";
            }

            ApplyGraphScope();
            _graphStatus = "Rendering layout…";
            StateHasChanged();
        }
        catch
        {
            _statusSuccess = false;
            _statusMessage = "Graph load failed. Refresh the graph or check the API response.";
            _isLoadingGraph = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnGraphLayoutSettled()
    {
        _isLoadingGraph = false;
        _graphStatus = string.Empty;
        await InvokeAsync(StateHasChanged);
        await SyncZoomFromGraphAsync();
    }

    public void Dispose()
    {
        _dotNetRef?.Dispose();
    }

    private async Task ImportGraphAsync()
    {
        _importing = true;
        _statusMessage = string.Empty;
        var result = await ApiClient.GraphImportAsync();
        _statusSuccess = result.IsSuccess;
        _statusMessage = result.IsSuccess ? "Graph imported successfully." : $"Import failed: {result.Error}";
        _importing = false;

        if (result.IsSuccess)
        {
            await LoadGraphAsync();
        }
    }

    private async Task FindPathAsync()
    {
        if (string.IsNullOrWhiteSpace(_pathFrom) || string.IsNullOrWhiteSpace(_pathTo))
        {
            return;
        }

        _pathResult = await ApiClient.GraphFindPathAsync(_pathFrom, _pathTo);
    }

    private async Task FitGraphAsync()
    {
        await JS.InvokeVoidAsync("fitGraph");
        await SyncZoomFromGraphAsync();
    }

    private async Task OnZoomSliderAsync(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var percent))
        {
            _zoomFactor = Math.Clamp(percent / 100.0, 0.25, 3.0);
            await ApplyZoomAsync();
        }
    }

    private async Task OnZoomFactorAsync(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var factor))
        {
            _zoomFactor = Math.Clamp(factor, 0.25, 3.0);
            await ApplyZoomAsync();
        }
    }

    private async Task ApplyZoomAsync()
    {
        await JS.InvokeVoidAsync("setGraphZoom", _zoomFactor);
    }

    private async Task SyncZoomFromGraphAsync()
    {
        var zoom = await JS.InvokeAsync<double>("getGraphZoom");
        if (zoom > 0)
        {
            _zoomFactor = Math.Clamp(zoom, 0.25, 3.0);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RelayoutGraphAsync()
    {
        await JS.InvokeVoidAsync("relayoutGraph");
    }

    private async Task SpreadGraphAsync()
    {
        await JS.InvokeVoidAsync("spreadGraph");
    }

    private async Task LoadRecentContextAsync(bool render = true)
    {
        _recentContext = (await RecentContext.GetAsync()).ToList();
        if (_selectedContextKeys.Count == 0 && _recentContext.Count > 0)
        {
            foreach (var item in _recentContext.Take(3))
            {
                _selectedContextKeys.Add(item.Key);
            }
        }

        _showFullGraph = _recentContext.Count == 0 || _selectedContextKeys.Count == 0;
        ApplyGraphScope();
        if (render)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task RefreshRecentContextAsync()
    {
        return LoadRecentContextAsync();
    }

    private async Task ToggleFullGraphAsync(ChangeEventArgs args)
    {
        _showFullGraph = args.Value is bool value && value;
        ApplyGraphScope();
        await InvokeAsync(StateHasChanged);
    }
    private async Task ToggleChunkNodesAsync(ChangeEventArgs args)
    {
        _showChunkNodes = args.Value is bool value && value;
        ApplyGraphScope();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleOrphanNodesAsync(ChangeEventArgs args)
    {
        _showOrphanNodes = args.Value is bool value && value;
        ApplyGraphScope();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleContextItemAsync(string key, ChangeEventArgs args)
    {
        var selected = args.Value is bool value && value;
        if (selected)
        {
            _selectedContextKeys.Add(key);
            _showFullGraph = false;
        }
        else
        {
            _selectedContextKeys.Remove(key);
        }

        ApplyGraphScope();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SelectAllContextAsync()
    {
        _selectedContextKeys = _recentContext
            .Select(item => item.Key)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        _showFullGraph = false;
        ApplyGraphScope();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearContextAsync()
    {
        _selectedContextKeys.Clear();
        _showFullGraph = true;
        ApplyGraphScope();
        await InvokeAsync(StateHasChanged);
    }
    private async Task ClearRecentContextListAsync()
    {
        await RecentContext.ClearAsync();
        _recentContext.Clear();
        _selectedContextKeys.Clear();
        _showFullGraph = true;
        ApplyGraphScope();
        await InvokeAsync(StateHasChanged);
    }


    private void ApplyGraphScope()
    {
        if (_allNodes is null || _allEdges is null)
        {
            return;
        }

        if (_showFullGraph || _selectedContextKeys.Count == 0)
        {
            _nodes = _allNodes;
            _edges = _allEdges;
        }
        else
        {
            var selectedItems = _recentContext
                .Where(item => _selectedContextKeys.Contains(item.Key))
                .ToList();
            (_nodes, _edges) = FilterGraph(_allNodes, _allEdges, selectedItems);
        }

        ApplyChunkFilter();
        ApplyOrphanFilter();

        _pathFrom = string.Empty;
        _pathTo = string.Empty;
        _pathResult = null;
        _renderGraphAfterRender = true;
    }

    private void ApplyChunkFilter()
    {
        if (_nodes is null || _edges is null || _showChunkNodes)
        {
            return;
        }

        var keptIds = _nodes
            .Where(node => !string.Equals(node.Type, "Chunk", StringComparison.OrdinalIgnoreCase))
            .Select(node => node.Id)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        _nodes = _nodes.Where(node => keptIds.Contains(node.Id)).ToList();
        _edges = _edges
            .Where(edge => keptIds.Contains(edge.SourceId) && keptIds.Contains(edge.TargetId))
            .ToList();

        if (!string.IsNullOrWhiteSpace(_pathFrom) && !keptIds.Contains(_pathFrom))
        {
            _pathFrom = string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(_pathTo) && !keptIds.Contains(_pathTo))
        {
            _pathTo = string.Empty;
        }
    }

    // Sprint 79: orphans are nodes with degree 0 — no edge lists them as SourceId or TargetId.
    // Computed on the current (post-context, post-chunk) edge set, so "orphan" means *isolated in
    // the rendered view* (a node whose only edges were to filtered chunk nodes is an orphan).
    private void ApplyOrphanFilter()
    {
        if (_nodes is null || _edges is null || _showOrphanNodes)
        {
            return;
        }

        (_nodes, _edges) = FilterOrphans(_nodes, _edges);

        var keptIds = _nodes.Select(node => node.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (!string.IsNullOrWhiteSpace(_pathFrom) && !keptIds.Contains(_pathFrom))
        {
            _pathFrom = string.Empty;
        }

        if (!string.IsNullOrWhiteSpace(_pathTo) && !keptIds.Contains(_pathTo))
        {
            _pathTo = string.Empty;
        }
    }

    public static (List<GraphNode> Nodes, List<GraphEdge> Edges) FilterOrphans(
        IReadOnlyList<GraphNode> nodes,
        IReadOnlyList<GraphEdge> edges)
    {
        var degree = edges
            .SelectMany(edge => new[] { edge.SourceId, edge.TargetId })
            .GroupBy(id => id, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.Count(), StringComparer.OrdinalIgnoreCase);

        var keptIds = nodes
            .Where(node => degree.TryGetValue(node.Id, out var nodeDegree) && nodeDegree > 0)
            .Select(node => node.Id)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        var filteredNodes = nodes.Where(node => keptIds.Contains(node.Id)).ToList();
        var filteredEdges = edges
            .Where(edge => keptIds.Contains(edge.SourceId) && keptIds.Contains(edge.TargetId))
            .ToList();

        return (filteredNodes, filteredEdges);
    }

    public static (List<GraphNode> Nodes, List<GraphEdge> Edges) FilterGraph(
        IReadOnlyList<GraphNode> allNodes,
        IReadOnlyList<GraphEdge> allEdges,
        IReadOnlyList<RecentGraphContextItem> selectedItems)
    {
        var matched = allNodes
            .Where(node => selectedItems.Any(item => MatchesContext(node, item)))
            .Select(node => node.Id)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        if (matched.Count == 0)
        {
            return (new List<GraphNode>(), new List<GraphEdge>());
        }

        var scopedEdges = allEdges
            .Where(edge => matched.Contains(edge.SourceId) || matched.Contains(edge.TargetId))
            .ToList();
        var scopedNodeIds = scopedEdges
            .SelectMany(edge => new[] { edge.SourceId, edge.TargetId })
            .Concat(matched)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var scopedNodes = allNodes
            .Where(node => scopedNodeIds.Contains(node.Id))
            .ToList();

        return (scopedNodes, scopedEdges);
    }

    private static bool MatchesContext(GraphNode node, RecentGraphContextItem item)
    {
        var haystack = string.Join(" ", new[]
        {
            node.Id,
            node.Label,
            node.Type,
            GetPropertyValue(node, "sourceId"),
            GetPropertyValue(node, "sourceName"),
            GetPropertyValue(node, "fileName")
        }.Where(value => !string.IsNullOrWhiteSpace(value)));

        if (item.Kind.Equals("document", StringComparison.OrdinalIgnoreCase))
        {
            return (!string.IsNullOrWhiteSpace(item.SourceId) && haystack.Contains(item.SourceId, StringComparison.OrdinalIgnoreCase))
                || haystack.Contains(item.Label, StringComparison.OrdinalIgnoreCase);
        }

        if (string.IsNullOrWhiteSpace(item.Query))
        {
            return false;
        }

        var terms = item.Query
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(term => term.Length > 2)
            .Take(6)
            .ToList();

        return terms.Count > 0 && terms.Any(term => haystack.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private static string? GetPropertyValue(GraphNode node, string key)
    {
        if (!node.Properties.TryGetValue(key, out var value) || value is null)
        {
            return null;
        }

        return value switch
        {
            JsonElement json => json.ValueKind == JsonValueKind.String ? json.GetString() : json.ToString(),
            _ => value.ToString()
        };
    }

    private string ContextSummary => _showFullGraph
        ? "Full graph mode"
        : $"{_selectedContextKeys.Count} selected";

    private static string ContextKindLabel(RecentGraphContextItem item)
    {
        return item.Kind.Equals("document", StringComparison.OrdinalIgnoreCase)
            ? "Document"
            : $"{item.Mode?.ToUpperInvariant() ?? "SEARCH"} search";
    }
}
