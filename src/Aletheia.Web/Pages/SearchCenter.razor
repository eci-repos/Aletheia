@page "/search"
@using Microsoft.Extensions.Configuration
@inject IConfiguration Config
@inject RepositoryApiClient ApiClient
@inject ActivityLogService ActivityLog
@inject RecentGraphContextService RecentGraphContext
@inject SearchScopeStateService Scope
@inject NavigationManager Navigation

<PageTitle>Search Center - Aletheia</PageTitle>

<h1>Search Center</h1>

<div class="mb-3">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="btn-group" role="group">
            <button type="button" class="btn @(_mode == "semantic" ? "btn-primary" : "btn-outline-primary")" @onclick="SetSemanticMode">Semantic</button>
            <button type="button" class="btn @(_mode == "summaries" ? "btn-primary" : "btn-outline-primary")" @onclick="SetSummariesMode">Summaries</button>
            @if (ShowInternalSearch)
            {
                <button type="button" class="btn @(_mode == "wrags" ? "btn-primary" : "btn-outline-primary")" @onclick="SetWragsMode">WRAGS</button>
                <button type="button" class="btn @(_mode == "graphrag" ? "btn-primary" : "btn-outline-primary")" @onclick="SetGraphRagMode">GraphRAG</button>
                <button type="button" class="btn @(_mode == "lazygraphrag" ? "btn-primary" : "btn-outline-primary")" @onclick="SetLazyGraphRagMode">LazyGraphRAG</button>
            }
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary" title="@ModeInfoTitle" aria-label="@ModeInfoTitle" @onclick="ToggleModeInfo">&#9432;</button>
    </div>
    @if (_showModeInfo)
    {
        <div class="alert alert-light small mb-0 mt-2 border">
            <strong>@ModeLabel:</strong> @ModeInfoDetail
        </div>
    }
</div>

<div class="mb-3">
    <div class="d-flex align-items-center justify-content-between mb-1">
        <label class="form-label mb-0">Theme scope</label>
        @if (_selectedThemes.Count > 0)
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearThemeScopeAsync">All themes</button>
        }
    </div>
    @if (_availableThemes.Count == 0)
    {
        <p class="text-muted small mb-0">No knowledge themes are available yet.</p>
    }
    else
    {
        <div class="d-flex flex-wrap gap-1">
            @foreach (var theme in _availableThemes)
            {
                <button type="button" class="btn btn-sm @(_selectedThemes.Contains(theme.Theme) ? "btn-primary" : "btn-outline-primary")" @onclick="() => ToggleTheme(theme.Theme)">
                    @theme.Theme <span class="text-muted">(@theme.DocumentCount)</span>
                </button>
            }
        </div>
    }
    @if (_selectedThemes.Count > 0)
    {
        <p class="small mb-0 mt-1">
            <span class="badge bg-info text-dark">Scoped to @_selectedThemes.Count theme(s): @string.Join(", ", _selectedThemes)</span>
            @if (_mode == "wrags")
            {
                <span class="text-muted"> Theme scope does not apply to WRAGS search.</span>
            }
        </p>
    }
</div>

<div class="input-group mb-3">
    <input type="text" class="form-control" placeholder="Enter your query..." @bind="_query" @bind:event="oninput" @onkeydown="HandleKeyDown" />
    <button class="btn btn-primary" @onclick="SearchAsync">Search</button>
</div>
<p class="text-muted small mb-0">
    Tip: semantic search matches by meaning across document chunks. For questions with conditions
    (for example, "only if part of the project objectives"), ask <a href="copilot">Copilot</a> —
    it scopes retrieval to specific documents and their template sections.
</p>

<div class="mb-3">
    <label class="form-label">Results to show: @_topK</label>
    <input type="range" class="form-range" min="1" max="20" @bind="_topK" />
</div>

@if (ShowInternalSearch && UsesExpansion(_mode))
{
    <div class="mb-3">
        <label class="form-label">Expansion: @_expansionHops</label>
        <input type="range" class="form-range" min="0" max="3" @bind="_expansionHops" />
    </div>
}

@if (_searching)
{
    <div class="alert alert-info">Searching...</div>
}

@if (!string.IsNullOrWhiteSpace(_searchError))
{
    <div class="alert alert-danger">@_searchError</div>
}

@if (_results is not null)
{
    @if (_results.Count == 0)
    {
        <div class="alert alert-warning">@EmptyStateMessage</div>
    }
    else
    {
        <h3>@ModeLabel Results (@_results.Count)</h3>
        @foreach (var result in _results)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">
                        @if (result.Rank > 0)
                        {
                            <span>Rank @result.Rank · </span>
                        }
                        Score: @result.Score.ToString("P2")
                        @if (!string.IsNullOrWhiteSpace(result.RetrievalStrategy))
                        {
                            <span> · @result.RetrievalStrategy</span>
                        }
                    </h6>
                    <p class="card-text">@result.Chunk.Content</p>
                    <div class="mb-2">
                        <a class="btn btn-sm btn-outline-primary" href="document/@result.Chunk.SourceId?page=@result.Chunk.PageNumber&chunk=@Uri.EscapeDataString(LeadingPhrase(result.Chunk.Content))">
                            View in document@(result.Chunk.PageNumber is not null ? $" (p. {result.Chunk.PageNumber})" : "")
                        </a>
                    </div>
                    @if (result.Citations.Count > 0)
                    {
                        <div class="small mb-2">
                            <strong>Citations:</strong> @string.Join(", ", result.Citations)
                        </div>
                    }
                    @if (result.RankingSignals.Count > 0 && result.RankingSignals.TryGetValue("final", out var finalScore))
                    {
                        <div class="small text-muted mb-2">Final rank score: @finalScore.ToString("P2")</div>
                    }
                    @if (result.Trace is not null)
                    {
                        <div class="small text-muted mb-2 p-2 border rounded bg-light">
                            <strong>Retrieval trace:</strong> strategy @result.Trace.Strategy ·
                            @result.Trace.LlmCalls LLM calls ·
                            @result.Trace.TokensConsumed tokens ·
                            @result.Trace.NodesVisited nodes ·
                            @result.Trace.RelationshipsTraversed relationships
                            @if (result.Trace.PruningRatio is not null)
                            {
                                <text> · pruning retained @result.Trace.PruningRatio.Value.ToString("P0")</text>
                            }
                            · @result.Trace.ElapsedMs ms
                            @if (result.Trace.Steps.Count > 0)
                            {
                                <div>Steps: @string.Join(" → ", result.Trace.Steps)</div>
                            }
                        </div>
                    }
                    <small class="text-muted">Chunk @result.Chunk.Index from source @result.Chunk.SourceId</small>
                </div>
            </div>
        }
    }
}

@if (ShowInternalSearch && _status is not null)
{
    <div class="alert alert-secondary small mb-3">
        <strong>RAGS status:</strong> @_status.EmbeddedChunkCount chunks · @_status.IngestedSourceCount sources ingested · @_status.RegisteredDocumentCount registered documents ·
        @_status.UncategorizedIngestCount uncategorized ingests · @_status.ExtractionFailureCount extraction failures
        @if (_status.UncategorizedIngests.Count > 0)
        {
            <div>Recent uncategorized ingests: @string.Join("; ", _status.UncategorizedIngests)</div>
        }
    </div>
}

@if (ShowInternalSearch)
{
    <AuthorizeView Roles="Administrator">
        <h3>Graph summaries</h3>
        <p class="text-muted small">Summary coverage across the knowledge graph. Summaries are generated from the connections between your documents — pre-built during GraphRAG ingestion, or on demand when you run a Summaries search. Re-cluster rebuilds the community structure.</p>
        <div class="mb-2">
            <button class="btn btn-outline-primary" @onclick="LoadSummariesStatusAsync">Refresh status</button>
            <button class="btn btn-outline-secondary" @onclick="ReclusterAsync" disabled="@_reclustering">
                @(_reclustering ? "Re-clustering..." : "Re-cluster communities")
            </button>
        </div>
        @if (_summariesStatus is not null)
        {
            <div class="alert alert-secondary small mb-2">
                <strong>Graph:</strong> @_summariesStatus.NodeCount nodes · @_summariesStatus.EntityCount entities ·
                @_summariesStatus.CommunityCount communities · @_summariesStatus.SummarizedCommunityCount summarized
                (@(_summariesStatus.CommunityCount > 0 ? Math.Round(100.0 * _summariesStatus.SummarizedCommunityCount / _summariesStatus.CommunityCount) : 0)%) ·
                @_summariesStatus.SourceCount sources
            </div>
            @if (_summariesStatus.Sources.Count > 0)
            {
                <table class="table table-sm">
                    <thead>
                        <tr><th>Source</th><th>Entities</th><th>Communities</th><th>Summarized</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var source in _summariesStatus.Sources)
                        {
                            <tr>
                                <td>@source.SourceName</td>
                                <td>@source.EntityCount</td>
                                <td>@source.CommunityCount</td>
                                <td>@source.SummarizedCommunityCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
        @if (!string.IsNullOrEmpty(_summariesStatusMessage))
        {
            <div class="alert @(_summariesStatusSuccess ? "alert-success" : "alert-warning") mt-2">@_summariesStatusMessage</div>
        }
    </AuthorizeView>
}

<hr />

@if (ShowInternalSearch)
{

<h3>Ingest Content</h3>
<p class="text-muted small">Admin: content pasted here is ingested without a canonical template and is not linked to a registered document. Prefer the Upload page for real documents. Wiki regeneration is managed from the Wiki page.</p>
<div class="mb-3">
    <textarea class="form-control" rows="5" placeholder="Paste content to ingest..." @bind="_ingestContent" @bind:event="oninput"></textarea>
</div>
<button class="btn btn-outline-primary" @onclick="IngestAsync" disabled="@_ingesting">
    @(_ingesting ? "Ingesting..." : "Ingest Content")
</button>
<button class="btn btn-outline-secondary mt-2" @onclick="ReembedAllAsync" disabled="@_reembedding">
    @(_reembedding ? "Re-embedding..." : "Re-embed all documents")
</button>
@if (!string.IsNullOrEmpty(_reembedStatus))
{
    <div class="alert @(_reembedSuccess ? "alert-success" : "alert-warning") mt-2">@_reembedStatus</div>
}

@if (!string.IsNullOrEmpty(_ingestStatus))
{
    <div class="alert @( _ingestSuccess ? "alert-success" : "alert-danger") mt-3">@_ingestStatus</div>
}

<hr />

<h3>Uncategorized documents</h3>
<p class="text-muted small">Documents ingested without a canonical template (Sprint 59 softened gate). Register a matching template under docs/doc-templates, then re-evaluate to promote them and generate document briefs.</p>
<div class="mb-2">
    <button class="btn btn-outline-primary" @onclick="LoadUncategorizedAsync">List uncategorized</button>
    <button class="btn btn-outline-secondary" @onclick="ReevaluateAsync" disabled="@_reevaluating">
        @(_reevaluating ? "Re-evaluating..." : "Re-evaluate all")
    </button>
</div>
@if (!string.IsNullOrEmpty(_reevaluateResult))
{
    <div class="alert alert-success mt-2">@_reevaluateResult</div>
}
@if (_uncategorizedRows is not null)
{
    @if (_uncategorizedRows.Count == 0)
    {
        <p class="text-muted small mt-2">No uncategorized documents.</p>
    }
    else
    {
        <table class="table table-sm mt-2">
            <thead>
                <tr><th>File</th><th>Status</th><th>Template</th></tr>
            </thead>
            <tbody>
                @foreach (var row in _uncategorizedRows)
                {
                    <tr>
                        <td>@row.FileName</td>
                        <td>@(string.IsNullOrWhiteSpace(row.TemplateStatus) ? "Not evaluated" : row.TemplateStatus)</td>
                        <td>@(row.TemplateName ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

}

@code {
    private string _query = string.Empty;
    private int _topK = 5;
    private int _expansionHops = 1;
    private string _mode = "semantic";
    private bool _searching;
    private string _searchError = string.Empty;
    private List<SearchResult>? _results;
    private RagsStatusClientSnapshot? _status;
    private bool _statusChecked;
    private bool _showModeInfo;

    private SummariesStatusSnapshot? _summariesStatus;
    private bool _reclustering;
    private string _summariesStatusMessage = string.Empty;
    private bool _summariesStatusSuccess;

    private string _ingestContent = string.Empty;
    private bool _ingesting;
    private string _ingestStatus = string.Empty;
    private bool _ingestSuccess;
    private bool _reembedding;
    private string _reembedStatus = string.Empty;
    private bool _reembedSuccess;

    private List<Aletheia.RAGS.Abstractions.Models.KnowledgeThemeCount> _availableThemes = new();
    private readonly HashSet<string> _selectedThemes = new(StringComparer.OrdinalIgnoreCase);

    private List<Aletheia.Repository.Abstractions.Models.FileThemeRow>? _uncategorizedRows;
    private bool _reevaluating;
    private string _reevaluateResult = string.Empty;

    private bool ShowInternalSearch { get; set; }

    private string EmptyStateMessage =>
        (_status?.EmbeddedChunkCount ?? 0) == 0
            ? "No documents have been ingested yet. Search only covers documents that finished background ingestion. Upload a document and wait for the Activity panel to show Ready, then retry. Example queries for a registered RFP Analysis document: Scope of Work, Project Summary, requirements."
            : $"No results found for \"{_query}\". Try words that appear in your documents (e.g., Scope of Work), or ask Copilot for questions with conditions.";

    protected override async Task OnInitializedAsync()
    {
        ShowInternalSearch = bool.TryParse(Config["FeatureFlags:ShowInternalSearch"], out var enabled) && enabled;
        if (!ShowInternalSearch)
        {
            _mode = "semantic";
        }

        // Sprint 59: restore the shared theme scope and load the theme catalog for the filter.
        var restoredScope = await Scope.RestoreAsync();
        foreach (var theme in restoredScope)
        {
            _selectedThemes.Add(theme);
        }

        _availableThemes = (await ApiClient.GetKnowledgeThemesAsync()).ToList();

        if (ShowInternalSearch)
        {
            await LoadSummariesStatusAsync();
        }

        var query = ReadQueryParam("q");
        if (!string.IsNullOrWhiteSpace(query))
        {
            _query = query;
            await SearchAsync();
        }
    }

    private string? ReadQueryParam(string key)
    {
        var query = Navigation.ToAbsoluteUri(Navigation.Uri).Query;
        if (string.IsNullOrWhiteSpace(query))
        {
            return null;
        }

        foreach (var pair in query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var separator = pair.IndexOf('=');
            var name = separator < 0 ? pair : pair[..separator];
            var value = separator < 0 ? string.Empty : pair[(separator + 1)..];
            if (string.Equals(name, key, StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(value.Replace('+', ' '));
            }
        }

        return null;
    }

    private void SetSemanticMode() => SetMode("semantic");
    private void SetSummariesMode() => SetMode("summaries");
    private void SetWragsMode() => SetMode("wrags");
    private void SetGraphRagMode() => SetMode("graphrag");
    private void SetLazyGraphRagMode() => SetMode("lazygraphrag");

    private string ModeLabel => _mode switch
    {
        "semantic" => "Semantic",
        "summaries" => "Summaries",
        "wrags" => "WRAGS",
        "graphrag" => "GraphRAG",
        "lazygraphrag" => "LazyGraphRAG",
        _ => _mode
    };

    private static bool UsesExpansion(string mode) => mode is "wrags" or "graphrag" or "lazygraphrag";

    private void ToggleModeInfo() => _showModeInfo = !_showModeInfo;

    private string ModeInfoTitle => _mode switch
    {
        "semantic" => "What does Semantic search do?",
        "summaries" => "What are Summaries?",
        "wrags" => "What is WRAGS search?",
        "graphrag" => "What is GraphRAG search?",
        "lazygraphrag" => "What is LazyGraphRAG search?",
        _ => "Search mode help"
    };

    private string ModeInfoDetail => _mode switch
    {
        "semantic" => "Semantic search matches by meaning across document chunks. It finds the exact passages most relevant to your question, even when the wording differs.",
        "summaries" => "Summaries are generated from the connections between your documents. They give higher-level answers synthesized across many documents. On large knowledge bases they may take time to appear.",
        "wrags" => "WRAGS reads durable wiki pages as retrieval context.",
        "graphrag" => "GraphRAG reads pre-built graph summaries and expanded graph context.",
        "lazygraphrag" => "LazyGraphRAG runs budgeted query-time graph traversal, building summaries on demand.",
        _ => string.Empty
    };

    /// <summary>Leading phrase of a chunk used to locate the passage in the document viewer. Kept short so it aligns with the extracted text.</summary>
    private static string LeadingPhrase(string content)
    {
        var trimmed = content.Trim();
        return trimmed.Length <= 100 ? trimmed : trimmed[..100];
    }

    private void SetMode(string mode)
    {
        // Semantic and Summaries are user-facing modes, always available. WRAGS/GraphRAG/LazyGraphRAG
        // are internal operator modes gated behind ShowInternalSearch.
        if (!ShowInternalSearch && mode is not ("semantic" or "summaries"))
        {
            return;
        }

        _mode = mode;
        _results = null;
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_query))
        {
            return;
        }

        var activityId = ActivityLog.Begin("Search Center", $"{ModeLabel} search", $"Searching for \"{_query}\".");
        _searching = true;
        _searchError = string.Empty;
        _results = null;

        try
        {
            if (_mode == "wrags")
            {
                ActivityLog.Trace(activityId, "Search Center", "WRAGS search", "Reading durable wiki pages as retrieval context.");
                var results = await ApiClient.WragsRetrieveAsync(_query, _topK, _expansionHops);
                _results = results?.ToList() ?? new List<SearchResult>();
            }
            else if (_mode == "graphrag")
            {
                ActivityLog.Trace(activityId, "Search Center", "GraphRAG search", "Reading graph summaries and expanded graph context.");
                // Sprint 64: the shared theme scope filters graph retrieval too (themes -> source ids server-side).
                var results = await ApiClient.GraphRagRetrieveAsync(_query, _topK, _expansionHops, _selectedThemes.ToList());
                _results = results?.ToList() ?? new List<SearchResult>();
            }
            else if (_mode == "lazygraphrag")
            {
                ActivityLog.Trace(activityId, "Search Center", "LazyGraphRAG search", "Running budgeted query-time graph traversal.");
                // Sprint 64: the shared theme scope filters graph retrieval too (themes -> source ids server-side).
                var results = await ApiClient.LazyGraphRagRetrieveAsync(_query, _topK, _expansionHops, _selectedThemes.ToList());
                _results = results?.ToList() ?? new List<SearchResult>();
            }
            else if (_mode == "summaries")
            {
                ActivityLog.Trace(activityId, "Search Center", "Summaries search", "Reading graph summaries (GraphRAG-first, LazyGraphRAG-fallback).");
                // User-facing summaries mode: the server resolves GraphRAG-first, LazyGraphRAG-fallback.
                var results = await ApiClient.SummariesRetrieveAsync(_query, _topK, _selectedThemes.ToList());
                _results = results?.ToList() ?? new List<SearchResult>();
            }
            else
            {
                ActivityLog.Trace(activityId, "Search Center", "Semantic search", "Retrieving ranked semantic chunks.");
                // Sprint 59: the shared theme scope filters semantic retrieval (themes -> source ids server-side).
                var results = await ApiClient.RagsRetrieveAsync(_query, _topK, _mode == "semantic" ? _selectedThemes.ToList() : null);
                _results = results?.ToList() ?? new List<SearchResult>();
            }

            ActivityLog.Complete(activityId, "Search Center", $"{ModeLabel} search", $"Search completed with {_results.Count} results.");
            if (_results.Count == 0 && !_statusChecked)
            {
                _status = await ApiClient.GetRagsStatusAsync();
                _statusChecked = true;
            }
            await RecentGraphContext.RecordSearchAsync(_query, _mode);
        }
        catch (Exception ex)
        {
            _results = new List<SearchResult>();
            _searchError = ex.Message;
            ActivityLog.Fail(activityId, "Search Center", $"{ModeLabel} search", ex.Message);
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task IngestAsync()
    {
        if (string.IsNullOrWhiteSpace(_ingestContent))
        {
            return;
        }

        var effectiveMode = ShowInternalSearch ? _mode : "semantic";
        var activityId = ActivityLog.Begin("Search Center", $"{effectiveMode} ingest", "Submitting content to ingestion API.");
        _ingesting = true;
        _ingestStatus = string.Empty;
        _ingestSuccess = false;

        try
        {
            BackgroundJobClientSnapshot? job;
            if (effectiveMode == "graphrag")
            {
                ActivityLog.Trace(activityId, "Search Center", "GraphRAG ingest", "Queueing GraphRAG ingestion job.");
                job = await ApiClient.GraphRagIngestJobAsync(Guid.NewGuid(), _ingestContent);
            }
            else if (effectiveMode == "lazygraphrag")
            {
                ActivityLog.Trace(activityId, "Search Center", "LazyGraphRAG ingest", "Queueing LazyGraphRAG ingestion job.");
                job = await ApiClient.LazyGraphRagIngestJobAsync(Guid.NewGuid(), _ingestContent);
            }
            else
            {
                ActivityLog.Trace(activityId, "Search Center", "Semantic ingest", "Generating chunks and embeddings.");
                job = await ApiClient.RagsIngestJobAsync(Guid.NewGuid(), _ingestContent);
            }

            _ingestSuccess = job is not null;
            _ingestStatus = job is not null ? "Ingestion job queued." : "Ingestion failed to queue.";

            if (job is not null)
            {
                ActivityLog.Complete(activityId, "Search Center", $"{effectiveMode} ingest", $"Background job {job.JobId:N} queued.");
                ActivityLog.UpsertJob(job);
                _ingestContent = string.Empty;
            }
            else
            {
                ActivityLog.Fail(activityId, "Search Center", $"{effectiveMode} ingest", "Ingestion API did not return a job.");
            }
        }
        catch (Exception ex)
        {
            _ingestSuccess = false;
            _ingestStatus = $"Ingestion failed: {ex.Message}";
            ActivityLog.Fail(activityId, "Search Center", $"{effectiveMode} ingest", ex.Message);
        }
        finally
        {
            _ingesting = false;
        }
    }

    private async Task ReembedAllAsync()
    {
        if (_reembedding)
        {
            return;
        }

        _reembedding = true;
        _reembedStatus = string.Empty;
        _reembedSuccess = false;
        try
        {
            var job = await ApiClient.ReembedAsync();
            if (job is null)
            {
                _reembedStatus = "Re-embed job failed to queue.";
                return;
            }

            _reembedSuccess = true;
            _reembedStatus = $"Re-embed job {job.JobId:N} queued. It regenerates embeddings for all registered documents.";
            ActivityLog.UpsertJob(job);
        }
        catch (Exception ex)
        {
            _reembedStatus = $"Re-embed failed: {ex.Message}";
        }
        finally
        {
            _reembedding = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task ToggleTheme(string theme)
    {
        if (!_selectedThemes.Add(theme))
        {
            _selectedThemes.Remove(theme);
        }

        await Scope.SetThemesAsync(_selectedThemes.ToList());
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearThemeScopeAsync()
    {
        _selectedThemes.Clear();
        await Scope.SetThemesAsync(Array.Empty<string>());
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadUncategorizedAsync()
    {
        _uncategorizedRows = (await ApiClient.GetUncategorizedAsync()).ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReevaluateAsync()
    {
        if (_reevaluating)
        {
            return;
        }

        _reevaluating = true;
        _reevaluateResult = string.Empty;
        try
        {
            var summary = await ApiClient.ReevaluateTemplatesAsync();
            _reevaluateResult = summary is null
                ? "Re-evaluation failed to run. Check the API logs."
                : $"Re-evaluation complete: {summary.Evaluated} evaluated, {summary.Promoted} promoted to Canonical (briefs queued), {summary.Uncategorized} still Uncategorized.";
            await LoadUncategorizedAsync();
        }
        catch (Exception ex)
        {
            _reevaluateResult = $"Re-evaluation failed: {ex.Message}";
        }
        finally
        {
            _reevaluating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadSummariesStatusAsync()
    {
        _summariesStatus = await ApiClient.GetSummariesStatusAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReclusterAsync()
    {
        if (_reclustering)
        {
            return;
        }

        _reclustering = true;
        _summariesStatusMessage = string.Empty;
        try
        {
            var ok = await ApiClient.DetectClustersAsync();
            _summariesStatusSuccess = ok;
            _summariesStatusMessage = ok
                ? "Community re-clustering queued. Summaries regenerate on demand during Summaries search."
                : "Re-clustering failed. Check the API logs.";
            await LoadSummariesStatusAsync();
        }
        catch (Exception ex)
        {
            _summariesStatusSuccess = false;
            _summariesStatusMessage = $"Re-clustering failed: {ex.Message}";
        }
        finally
        {
            _reclustering = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}

