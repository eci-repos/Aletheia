@page "/settings"
@using Aletheia.Foundation.Security
@using Aletheia.Web.Services
@inject RepositoryApiClient ApiClient
@inject AuthService Auth

<PageTitle>Settings - Aletheia</PageTitle>

<h3>Settings</h3>

<AuthorizeView Context="authContext">
    <NotAuthorized>
        <div class="alert alert-warning">Please <a href="login">log in</a> to manage your preferences.</div>
    </NotAuthorized>
    <Authorized>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-dark text-white">My Preferences</div>
                    <div class="card-body">
                        <p class="text-muted">These preferences apply to your account.</p>

                        <div class="form-check form-switch">
                            <input type="checkbox" class="form-check-input" id="requireApproval"
                                   checked="@_requireApproval" @onchange="SaveRequireApprovalAsync" />
                            <label class="form-check-label" for="requireApproval">
                                Require approval before Copilot runs a plan
                            </label>
                            <div class="small text-muted">
                                When off, plans auto-approve and run immediately after planning.
                            </div>
                        </div>

                        @if (_saved is not null)
                        {
                            <div class="alert alert-@(_saved == true ? "success" : "danger") mt-3 mb-0">@_savedMessage</div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <AuthorizeView Roles="Administrator" Context="adminContext">
                    <Authorized>
                        <div class="card">
                            <div class="card-header bg-secondary text-white">Global Settings (Administrator)</div>
                            <div class="card-body">
                                <p class="text-muted">Global settings are managed by administrators and apply to all users.</p>

                                <div class="form-check form-switch">
                                    <input type="checkbox" class="form-check-input" id="forceApproval"
                                           checked="@_forceApproval" @onchange="SaveForceApprovalAsync" />
                                    <label class="form-check-label" for="forceApproval">
                                        Force approval for all users
                                    </label>
                                    <div class="small text-muted">
                                        Forces the Copilot approval prompt even for users who opted out via "Don't ask again".
                                    </div>
                                </div>

                                @if (_globalSaved is not null)
                                {
                                    <div class="alert alert-@(_globalSaved == true ? "success" : "danger") mt-3 mb-0">@_globalSavedMessage</div>
                                }
                            </div>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="card">
                            <div class="card-header bg-light">Global Settings</div>
                            <div class="card-body text-muted">
                                Global settings are visible to administrators only.
                            </div>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <AuthorizeView Roles="Administrator" Context="adminContext">
            <Authorized>
                <div class="card mt-3">
                    <div class="card-header bg-secondary text-white">AI Agent Instructions (Administrator)</div>
                    <div class="card-body">
                        <p class="text-muted">
                            Per-role system prompts that shape how each AI agent behaves. Overrides take effect
                            immediately; reset returns a role to its config default.
                        </p>

                        @if (_agentInstructions is null)
                        {
                            <div class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></div>
                        }
                        else
                        {
                            @foreach (var item in _agentInstructions)
                            {
                                <div class="agent-instruction-item mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <strong class="text-break">@item.Role</strong>
                                        <span class="badge @(item.Source == "override" ? "bg-warning text-dark" : "bg-light text-dark border")">
                                            @(item.Source == "override" ? "Customized" : "Config default")
                                        </span>
                                    </div>
                                    <textarea class="form-control form-control-sm" rows="3" @bind="item.Value"></textarea>
                                    <div class="mt-1">
                                        <button class="btn btn-sm btn-primary" @onclick="() => SaveAgentInstructionAsync(item)">Save</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ResetAgentInstructionAsync(item)" disabled="@(item.Source != "override")">Reset to config default</button>
                                    </div>
                                </div>
                            }
                        }

                        @if (!string.IsNullOrEmpty(_agentInstructionsMessage))
                        {
                            <div class="alert alert-@(_agentInstructionsSuccess ? "success" : "danger") mt-2 mb-0">@_agentInstructionsMessage</div>
                        }
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
    </Authorized>
</AuthorizeView>

@code {
    private bool _requireApproval = true;
    private bool _forceApproval;
    private bool? _saved;
    private bool? _globalSaved;
    private string _savedMessage = string.Empty;
    private string _globalSavedMessage = string.Empty;
    private List<AgentInstructionItem>? _agentInstructions;
    private string _agentInstructionsMessage = string.Empty;
    private bool _agentInstructionsSuccess;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var mine = await ApiClient.GetMySettingsAsync();
            if (mine is not null &&
                mine.TryGetValue(Aletheia.RAGS.Abstractions.Configuration.ChatApprovalSettings.RequireApproval, out var pref))
            {
                _requireApproval = !string.Equals(pref, "false", StringComparison.OrdinalIgnoreCase);
            }

            var state = await Auth.GetAuthenticationStateAsync();
            if (state.User.IsInRole(RoleDefinitions.Administrator))
            {
                var app = await ApiClient.GetAppSettingsAsync();
                if (app is not null &&
                    app.TryGetValue(Aletheia.RAGS.Abstractions.Configuration.ChatApprovalSettings.ForceApproval, out var force))
                {
                    _forceApproval = string.Equals(force, "true", StringComparison.OrdinalIgnoreCase);
                }

                _agentInstructions = (await ApiClient.GetAgentInstructionsAsync())?.ToList();
            }
        }
        catch (HttpRequestException)
        {
            // Keep defaults; the API enforces access.
        }
    }

    private async Task SaveAgentInstructionAsync(AgentInstructionItem item)
    {
        var ok = await ApiClient.UpdateAgentInstructionAsync(item.Role, item.Value);
        _agentInstructionsSuccess = ok;
        _agentInstructionsMessage = ok
            ? $"Saved {item.Role}."
            : $"Failed to save {item.Role}.";
        if (ok)
        {
            item.Source = "override";
        }
    }

    private async Task ResetAgentInstructionAsync(AgentInstructionItem item)
    {
        var ok = await ApiClient.ResetAgentInstructionAsync(item.Role);
        _agentInstructionsSuccess = ok;
        _agentInstructionsMessage = ok
            ? $"Reset {item.Role} to config default."
            : $"Failed to reset {item.Role}.";
        if (ok)
        {
            // Re-fetch so the value reflects the config baseline.
            _agentInstructions = (await ApiClient.GetAgentInstructionsAsync())?.ToList();
        }
    }

    private async Task SaveRequireApprovalAsync()
    {
        _saved = null;
        var ok = await ApiClient.UpdateMySettingsAsync(new Dictionary<string, string>
        {
            [Aletheia.RAGS.Abstractions.Configuration.ChatApprovalSettings.RequireApproval] = _requireApproval.ToString()
        });
        _saved = ok;
        _savedMessage = ok
            ? "Preference saved."
            : "Failed to save preference.";
    }

    private async Task SaveForceApprovalAsync()
    {
        _globalSaved = null;
        var ok = await ApiClient.UpdateAppSettingsAsync(new Dictionary<string, string>
        {
            [Aletheia.RAGS.Abstractions.Configuration.ChatApprovalSettings.ForceApproval] = _forceApproval.ToString()
        });
        _globalSaved = ok;
        _globalSavedMessage = ok
            ? "Global setting saved."
            : "Failed to save global setting.";
    }
}
