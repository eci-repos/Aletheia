@page "/copilot"
@using System.Text
@using System.Text.Encodings.Web
@using System.Text.RegularExpressions
@implements IDisposable
@inject RepositoryApiClient ApiClient
@inject ActivityLogService ActivityLog
@inject CopilotStateService CopilotState
@inject IJSRuntime JS

<PageTitle>AI Copilot</PageTitle>

<div class="copilot-page">
    <h3>AI Copilot</h3>

    <div class="copilot-layout @LayoutClass" style="@LayoutStyle">
        <div class="copilot-conversation-column">
            <div class="card copilot-conversation-card">
                <div class="card-header bg-primary text-white d-flex align-items-center justify-content-between">
                    <span>Conversation</span>
                    <div class="copilot-header-actions">
                        <button class="btn btn-sm btn-light" @onclick="ResetChatAsync">New chat</button>
                        <button class="btn btn-sm btn-outline-light" @onclick="OpenThemePickerAsync" title="Scope this session to knowledge themes">Knowledge</button>
                        @if (_executionPanelCollapsed)
                        {
                            <button class="btn btn-sm btn-light" @onclick="RestoreExecutionPanelAsync">Show execution</button>
                        }
                    </div>
                </div>
                @if (_session.ThemeFilter is { Count: > 0 })
                {
                    <div class="copilot-theme-chips">
                        <span class="copilot-theme-chips-label">Knowledge:</span>
                        @foreach (var theme in _session.ThemeFilter)
                        {
                            <span class="badge rounded-pill bg-info text-dark copilot-theme-chip">@theme</span>
                        }
                        <button class="btn btn-sm btn-outline-secondary copilot-theme-edit" @onclick="OpenThemePickerAsync" title="Edit knowledge themes">Edit</button>
                    </div>
                }
                @if (_showThemePicker)
                {
                    <div class="card copilot-theme-picker">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <strong>Knowledge themes</strong>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="SelectAllThemesAsync">All themes</button>
                            </div>
                            @if (_availableThemes.Count == 0)
                            {
                                <p class="text-muted small mb-2">No knowledge themes are available yet.</p>
                            }
                            else
                            {
                                <div class="copilot-theme-options">
                                    @foreach (var theme in _availableThemes)
                                    {
                                        <label class="form-check copilot-theme-option">
                                            <input type="checkbox" class="form-check-input" checked="@_selectedThemes.Contains(theme.Theme)" @onchange="@(() => ToggleTheme(theme.Theme))" />
                                            <span class="form-check-label">
                                                @theme.Theme
                                                <span class="text-muted small">(@theme.DocumentCount)</span>
                                            </span>
                                        </label>
                                    }
                                </div>
                            }
                            <div class="d-flex gap-2 mt-3">
                                <button class="btn btn-sm btn-primary" @onclick="ApplyThemePickerAsync" disabled="@_isChatting">Apply to session</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelThemePickerAsync">Cancel</button>
                            </div>
                        </div>
                    </div>
                }
                <div class="card-body copilot-conversation-body">
                    @if (_session.Messages.Count == 0)
                    {
                        <p class="text-muted">Start a conversation...</p>
                    }
                    else
                    {
                        @foreach (var msg in _session.Messages)
                        {
                            <div class="copilot-message mb-3">
                                <strong class="text-@(msg.Role == "user" ? "primary" : "success")">@(msg.Role == "user" ? "You" : "Copilot"):</strong>
                                @if (msg.Role == "assistant")
                                {
                                    <div class="copilot-assistant-message">@RenderMarkdown(msg.Content)</div>
                                    @if (msg.Stats is not null)
                                    {
                                        <div class="copilot-stats" title="@msg.Stats.ConfidenceBasis">
                                            <span>@msg.Stats.ElapsedSeconds.ToString("0.0")s</span>
                                            <span>@msg.Stats.TokensPerSecond.ToString("0.0") tok/s</span>
                                            <span>@msg.Stats.EstimatedCompletionTokens est. tokens</span>
                                            <span>@msg.Stats.RetrievedContextCount context</span>
                                            <span>@msg.Stats.CitationCount citations</span>
                                            <span>@(Math.Round(msg.Stats.AlignmentConfidence * 100))% confidence</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="copilot-user-message">@msg.Content</span>
                                }
                            </div>
                        }
                    }

                    @if (_isChatting)
                    {
                        <div class="text-muted">Copilot is thinking...</div>
                    }
                </div>
                <div class="card-footer">
                    @if (!string.IsNullOrWhiteSpace(_chatError))
                    {
                        <div class="alert alert-warning py-2 mb-2">@_chatError</div>
                    }
                    <div class="input-group copilot-input-group">
                        <select class="form-select copilot-format-select" value="@_outputFormat" @onchange="UpdateOutputFormatAsync" disabled="@IsInputDisabled" aria-label="Response format">
                            <option value="auto">Auto</option>
                            <option value="summary">Summary</option>
                            <option value="table">Table</option>
                            <option value="bullets">Bullets</option>
                            <option value="json">JSON</option>
                        </select>
                        <input type="text" class="form-control" value="@_userInput" @oninput="UpdateUserInputAsync" placeholder="Ask a question..." @onkeydown="HandleKeyPress" />
                        <button class="btn btn-primary" @onclick="SendChat" disabled="@IsInputDisabled">Send</button>
                    </div>
                </div>
            </div>
        </div>

        @if (!_executionPanelCollapsed)
        {
            <button class="copilot-resize-handle" title="Resize execution panel" aria-label="Resize execution panel" @onpointerdown="StartResizeAsync"></button>
        }

        <div class="copilot-plan-column" aria-hidden="@_executionPanelCollapsed">
            <div class="copilot-side-header">
                <span>Execution</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CollapseExecutionPanelAsync">Close</button>
            </div>

            @if (IsPlanPreviewVisible)
            {
                <PlanPreview
                    Plan="_pendingPlan"
                    IsBusy="_isBusy"
                    StatusMessage="@_planStatusMessage"
                    OnApprove="ApprovePlan"
                    OnRevise="RevisePlan"
                    OnCancel="CancelPlan" />
            }

            @if (_progress is not null)
            {
                <ProgressPanel
                    Progress="_progress"
                    Telemetry="_telemetry"
                    IsCancelling="_isCancelling"
                    OnCancel="CancelJob" />
            }

            @if (_pendingPlan is not null && !IsPlanPreviewVisible && _progress is null)
            {
                <div class="copilot-panel-empty text-muted">Execution queued. Progress will appear shortly.</div>
            }

            @if (_pendingPlan is null && _progress is null)
            {
                <div class="copilot-panel-empty text-muted">No active execution.</div>
            }
        </div>
    </div>
</div>

@code {
    private ChatSession _session = new();
    private string _userInput = string.Empty;
    private string _outputFormat = "auto";
    private bool _isChatting = false;
    private string _chatError = string.Empty;

    private ChatPlanRecord? _pendingPlan;
    private ChatProgressRecord? _progress;
    private ChatExecutionTelemetry? _telemetry;
    private Guid? _activeJobId;
    private Action<ChatSession>? _sessionOpenedHandler;
    private bool _isBusy = false;
    private bool _isCancelling = false;
    private string _planStatusMessage = string.Empty;
    private CancellationTokenSource _pollingCts = new();
    private bool _stateRestored;
    private bool _executionPanelCollapsed;
    private double _executionPanelWidth = 360;
    private DotNetObjectReference<Index>? _dotNetRef;
    private Guid? _chatActivityId;
    private readonly HashSet<string> _loggedProgressMessages = new(StringComparer.Ordinal);
    private List<Aletheia.RAGS.Abstractions.Models.KnowledgeThemeCount> _availableThemes = new();
    private readonly HashSet<string> _selectedThemes = new(StringComparer.OrdinalIgnoreCase);
    private bool _showThemePicker;

    private bool IsInputDisabled => _isChatting || _isBusy;

    private bool IsPlanPreviewVisible => _pendingPlan is not null && !_activeJobId.HasValue && _progress is null;

    private string LayoutClass => _executionPanelCollapsed ? "execution-collapsed" : string.Empty;

    private string LayoutStyle => $"--copilot-side-width: {_executionPanelWidth:0}px;";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _sessionOpenedHandler = session => _ = HandleSessionOpened(session);
            CopilotState.SessionOpened += _sessionOpenedHandler;
            await CopilotState.LoadRecentSessionsAsync();
            await LoadKnowledgeThemesAsync();
        }

        if (!firstRender || _stateRestored)
        {
            return;
        }

        _stateRestored = true;
        var state = await CopilotState.RestoreAsync();
        ApplyState(state);
        // Sprint 58: surface the knowledge-theme picker immediately for a fresh session so the
        // filtering option is discoverable without having to click "New chat" first.
        if (_session.Messages.Count == 0)
        {
            _showThemePicker = true;
        }

        await InvokeAsync(StateHasChanged);

        if (_pendingPlan is not null || _activeJobId.HasValue)
        {
            _ = StartProgressPollingAsync();
        }
        else
        {
            _ = RestoreActiveExecutionAsync();
        }
    }

    public void Dispose()
    {
        if (_sessionOpenedHandler is not null)
        {
            CopilotState.SessionOpened -= _sessionOpenedHandler;
        }
        _pollingCts.Cancel();
        _pollingCts.Dispose();
        _dotNetRef?.Dispose();
    }

    private async Task LoadKnowledgeThemesAsync()
    {
        _availableThemes = (await ApiClient.GetKnowledgeThemesAsync()).ToList();
        _selectedThemes.Clear();
        if (_session.ThemeFilter is { Count: > 0 })
        {
            foreach (var theme in _session.ThemeFilter)
            {
                _selectedThemes.Add(theme);
            }
        }
    }

    private async Task OpenThemePickerAsync()
    {
        _selectedThemes.Clear();
        if (_session.ThemeFilter is { Count: > 0 })
        {
            foreach (var theme in _session.ThemeFilter)
            {
                _selectedThemes.Add(theme);
            }
        }

        _showThemePicker = true;
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleTheme(string theme)
    {
        if (!_selectedThemes.Add(theme))
        {
            _selectedThemes.Remove(theme);
        }
    }

    private async Task SelectAllThemesAsync()
    {
        _selectedThemes.Clear();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyThemePickerAsync()
    {
        _session.ThemeFilter = _selectedThemes.Count == 0
            ? new List<string>()
            : _selectedThemes.ToList();
        _showThemePicker = false;
        await CopilotState.SaveAsync(new CopilotClientState { Session = _session });
        await InvokeAsync(StateHasChanged);
    }

    private async Task CancelThemePickerAsync()
    {
        _showThemePicker = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleSessionOpened(ChatSession session)
    {
        if (_session.Messages.Count > 0 && _session.Id != session.Id)
        {
            await CopilotState.SaveCurrentSessionToHistoryAsync(_session);
        }

        _pollingCts.Cancel();
        _session = session;
        _userInput = string.Empty;
        _outputFormat = "auto";
        _isChatting = false;
        _isBusy = false;
        _isCancelling = false;
        _chatError = string.Empty;
        _pendingPlan = null;
        _progress = null;
        _telemetry = null;
        _activeJobId = null;
        _planStatusMessage = string.Empty;
        _loggedProgressMessages.Clear();
        _selectedThemes.Clear();
        if (session.ThemeFilter is { Count: > 0 })
        {
            foreach (var theme in session.ThemeFilter)
            {
                _selectedThemes.Add(theme);
            }
        }

        await CopilotState.SaveAsync(new CopilotClientState { Session = session });
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendChat();
        }
    }

    private async Task SendChat()
    {
        if (IsInputDisabled || string.IsNullOrWhiteSpace(_userInput))
        {
            return;
        }

        var userMessage = _userInput.Trim();
        ResetExecutionPanel();
        _chatActivityId = ActivityLog.Begin("Copilot", "Chat request", $"Prompt sent for planning: {TrimForActivity(userMessage)}");
        _isChatting = true;
        _chatError = string.Empty;
        _userInput = string.Empty;
        _session.Messages.Add(new ChatMessage { Role = "user", Content = userMessage });
        _session.LastActivity = DateTimeOffset.UtcNow;

        if (_session.Messages.Count == 1)
        {
            _session.Title = userMessage.Length > 40 ? userMessage[..40] + "..." : userMessage;
        }

        try
        {
            var history = _session.Messages.Count > 1
                ? _session.Messages.Take(_session.Messages.Count - 1).ToList()
                : new List<ChatMessage>();
            _pendingPlan = await ApiClient.PlanChatAsync(userMessage, _session.Id, history, _session.ThemeFilter is { Count: > 0 } ? _session.ThemeFilter : null);
            if (_pendingPlan is null)
            {
                _chatError = "Planning failed: the API returned no execution plan.";
                if (_chatActivityId.HasValue)
                {
                    ActivityLog.Fail(_chatActivityId.Value, "Copilot", "Planning failed", _chatError);
                }

                return;
            }

            _planStatusMessage = _pendingPlan.RequiresApproval
                ? "Review the plan and click Run to start."
                : "Ready to run. Review the plan and click Run to start.";
            ActivityLog.Trace(
                _chatActivityId.Value,
                "Copilot",
                "Execution plan",
                $"Plan ready. Mode: {_pendingPlan.Mode}; tool: {(_pendingPlan.RequiresToolCall ? _pendingPlan.ToolName : "repository lookup will be enforced if configured")}.");
        }
        catch (Exception ex)
        {
            _chatError = $"Planning failed: {ex.Message}";
            if (_chatActivityId.HasValue)
            {
                ActivityLog.Fail(_chatActivityId.Value, "Copilot", "Planning failed", ex.Message);
            }
        }
        finally
        {
            _isChatting = false;
            await SaveStateAsync();
        }
    }

    private async Task ApprovePlan()
    {
        if (_pendingPlan is null || _isBusy)
        {
            return;
        }

        _isBusy = true;
        _planStatusMessage = string.Empty;
        _chatActivityId ??= ActivityLog.Begin("Copilot", "Chat request", $"Executing prompt: {TrimForActivity(_pendingPlan.Prompt)}");
        ActivityLog.Trace(_chatActivityId.Value, "Copilot", "Approval accepted", "Execution plan approved; starting background chat job.");
        await SaveStateAsync();

        try
        {
            var approved = await ApiClient.ApproveChatPlanAsync(_pendingPlan.PlanId);
            if (approved is null)
            {
                _planStatusMessage = "Approval failed.";
                ActivityLog.Fail(_chatActivityId.Value, "Copilot", "Approval failed", "The API did not approve the chat plan.");
                return;
            }

            _pendingPlan = approved;
            var job = await ApiClient.ExecuteChatPlanAsync(_pendingPlan.PlanId);
            if (job is null)
            {
                _planStatusMessage = "Execution failed to start.";
                ActivityLog.Fail(_chatActivityId.Value, "Copilot", "Execution failed to start", "The API did not return a chat job.");
                return;
            }

            _activeJobId = job.JobId;
            _chatActivityId = job.JobId;
            ActivityLog.UpsertChatJob(job);
            ActivityLog.Trace(_chatActivityId.Value, "Copilot", "Background execution", $"Job {job.JobId:N} queued. Stage: {job.Stage}.");
            await SaveStateAsync();
            await StartProgressPollingAsync();
        }
        catch (Exception ex)
        {
            _planStatusMessage = $"Approval error: {ex.Message}";
            ActivityLog.Fail(_chatActivityId.Value, "Copilot", "Approval error", ex.Message);
        }
        finally
        {
            _isBusy = false;
            await SaveStateAsync();
        }
    }

    private async Task RevisePlan()
    {
        _pendingPlan = null;
        _planStatusMessage = string.Empty;
        await SaveStateAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CancelPlan()
    {
        if (_pendingPlan is null || _isBusy)
        {
            return;
        }

        _isBusy = true;
        try
        {
            var cancelled = await ApiClient.CancelChatPlanAsync(_pendingPlan.PlanId, "Cancelled by user.");
            if (cancelled is not null)
            {
                _pendingPlan = cancelled;
                await SaveStateAsync();
            }
        }
        finally
        {
            _isBusy = false;
            await SaveStateAsync();
        }
    }

    private async Task CancelJob()
    {
        if (!_activeJobId.HasValue || _isCancelling)
        {
            return;
        }

        _isCancelling = true;
        try
        {
            await ApiClient.CancelChatJobAsync(_activeJobId.Value);
        }
        finally
        {
            _isCancelling = false;
            await SaveStateAsync();
        }
    }

    private async Task StartProgressPollingAsync()
    {
        _pollingCts.Cancel();
        _pollingCts.Dispose();
        _pollingCts = new CancellationTokenSource();
        var pollingToken = _pollingCts.Token;

        try
        {
            var consecutiveFailures = 0;
            while (!pollingToken.IsCancellationRequested)
            {
                var hasActiveExecution = await RefreshProgressAsync();

                if (hasActiveExecution && _progress?.Status is ChatJobStatus.Succeeded or ChatJobStatus.Failed or ChatJobStatus.Cancelled)
                {
                    if (_progress.Status == ChatJobStatus.Succeeded && !string.IsNullOrWhiteSpace(_progress.FinalResult))
                    {
                        _session.Messages.Add(new ChatMessage
                        {
                            Role = "assistant",
                            Content = _progress.FinalResult,
                            Stats = _telemetry is not null
                                ? new ChatCompletionStats
                                {
                                    ElapsedSeconds = _telemetry.ElapsedSeconds,
                                    EstimatedPromptTokens = _telemetry.PromptTokens,
                                    EstimatedCompletionTokens = _telemetry.CompletionTokens,
                                    TokensPerSecond = _telemetry.TokensPerSecond,
                                    RetrievedContextCount = _telemetry.RetrievalCount,
                                    CitationCount = _telemetry.CitationCount,
                                    AlignmentConfidence = _telemetry.AlignmentConfidence,
                                    ConfidenceBasis = $"{_telemetry.ConfidenceBasis} {_telemetry.EstimateComparisonSummary}"
                                }
                                : new ChatCompletionStats
                                {
                                    RetrievedContextCount = 0,
                                    CitationCount = 0,
                                    ConfidenceBasis = "Background execution completed."
                                }
                        });
                        _session.LastActivity = DateTimeOffset.UtcNow;
                    }

                    _pendingPlan = null;
                    await SaveStateAsync();
                    break;
                }

                if (!hasActiveExecution)
                {
                    // No execution is reporting progress: the plan is not started yet, its job is
                    // gone (e.g. the API container restarted and in-memory chat jobs were lost), or
                    // the API could not be reached. Stop after a few attempts instead of polling
                    // forever — the plan preview (or the "no active execution" panel) stays visible
                    // so the user can act.
                    consecutiveFailures++;
                    if (consecutiveFailures >= 3)
                    {
                        break;
                    }
                }
                else
                {
                    consecutiveFailures = 0;
                }

                await Task.Delay(TimeSpan.FromSeconds(2), pollingToken).ConfigureAwait(false);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task<bool> RefreshProgressAsync()
    {
        if (_pendingPlan is null)
        {
            return false;
        }

        var progress = await ApiClient.GetChatPlanProgressAsync(_pendingPlan.PlanId);
        if (progress is null)
        {
            return false;
        }

        if (progress.JobId == Guid.Empty)
        {
            // The plan exists but has no execution job yet (not started). Clear any stale execution
            // state restored from a previous session and keep the plan preview visible so the user
            // can run the plan.
            _activeJobId = null;
            _progress = null;
            _telemetry = null;
            await SaveStateAsync();
            await InvokeAsync(StateHasChanged);
            return false;
        }

        if (progress.PlanId != _pendingPlan.PlanId)
        {
            return false;
        }

        _progress = progress;
        if (progress.JobId != Guid.Empty)
        {
            _activeJobId = progress.JobId;
        }

        ActivityLog.UpsertChatJob(ToChatJobSnapshot(progress));
        MirrorProgressMessagesToActivity(progress);

        if (progress.Telemetry is not null)
        {
            _telemetry = progress.Telemetry;
        }
        else if (_activeJobId.HasValue && progress.Status is ChatJobStatus.Succeeded or ChatJobStatus.Failed)
        {
            var telemetry = await ApiClient.GetChatJobTelemetryAsync(_activeJobId.Value);
            _telemetry = telemetry;
        }
        else
        {
            _telemetry = null;
        }

        await SaveStateAsync();
        await InvokeAsync(StateHasChanged);
        return true;
    }

    private async Task RestoreActiveExecutionAsync()
    {
        try
        {
            var jobs = await ApiClient.GetChatJobsAsync(200);
            var chatJob = jobs?.FirstOrDefault(job => job.Status is ChatJobStatus.Queued or ChatJobStatus.Running);
            if (chatJob is null)
            {
                return;
            }

            _activeJobId = chatJob.JobId;
            _chatActivityId = chatJob.JobId;
            ActivityLog.UpsertChatJob(chatJob);
            _progress = await ApiClient.GetChatPlanProgressAsync(chatJob.PlanId);
            if (_progress is not null)
            {
                _pendingPlan = new ChatPlanRecord
                {
                    PlanId = _progress.PlanId,
                    Prompt = _progress.Prompt
                };
            }

            await SaveStateAsync();
            await StartProgressPollingAsync();
        }
        catch
        {
        }
    }

    private void ResetExecutionPanel()
    {
        _pollingCts.Cancel();
        _pendingPlan = null;
        _progress = null;
        _telemetry = null;
        _activeJobId = null;
        _isCancelling = false;
        _planStatusMessage = string.Empty;
        _chatActivityId = null;
        _loggedProgressMessages.Clear();
    }

    private async Task ResetChatAsync()
    {
        _pollingCts.Cancel();
        if (_session.Messages.Count > 0)
        {
            await CopilotState.SaveCurrentSessionToHistoryAsync(_session);
        }

        _session = new ChatSession();
        _userInput = string.Empty;
        _outputFormat = "auto";
        _isChatting = false;
        _isBusy = false;
        _isCancelling = false;
        _chatError = string.Empty;
        _pendingPlan = null;
        _progress = null;
        _telemetry = null;
        _activeJobId = null;
        _planStatusMessage = string.Empty;
        _executionPanelCollapsed = false;
        _executionPanelWidth = 360;
        _chatActivityId = null;
        _loggedProgressMessages.Clear();
        _selectedThemes.Clear();
        _showThemePicker = true;

        await CopilotState.ClearAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task UpdateUserInputAsync(ChangeEventArgs args)
    {
        _userInput = args.Value?.ToString() ?? string.Empty;
        await SaveStateAsync();
    }

    private async Task UpdateOutputFormatAsync(ChangeEventArgs args)
    {
        _outputFormat = args.Value?.ToString() ?? "auto";
        await SaveStateAsync();
    }

    private async Task CollapseExecutionPanelAsync()
    {
        _executionPanelCollapsed = true;
        await SaveStateAsync();
    }

    private async Task RestoreExecutionPanelAsync()
    {
        _executionPanelCollapsed = false;
        await SaveStateAsync();
    }

    private async Task StartResizeAsync(PointerEventArgs args)
    {
        _dotNetRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("aletheia.startCopilotResize", _dotNetRef, args.ClientX, _executionPanelWidth);
    }

    [JSInvokable]
    public async Task UpdateExecutionPanelWidth(double width)
    {
        _executionPanelWidth = CopilotStateService.ClampPanelWidth(width);
        await SaveStateAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void ApplyState(CopilotClientState state)
    {
        _session = state.Session;
        _userInput = state.UserInput;
        _outputFormat = state.OutputFormat;
        _pendingPlan = state.PendingPlan;
        _progress = state.Progress;
        _telemetry = state.Telemetry;
        _activeJobId = state.ActiveJobId;
        _isBusy = false;
        _isCancelling = false;
        _planStatusMessage = state.PlanStatusMessage;
        _chatError = state.ChatError;
        _executionPanelCollapsed = state.ExecutionPanelCollapsed;
        _executionPanelWidth = CopilotStateService.ClampPanelWidth(state.ExecutionPanelWidth);
    }

    private Task SaveStateAsync()
    {
        return CopilotState.SaveAsync(new CopilotClientState
        {
            Session = _session,
            UserInput = _userInput,
            OutputFormat = _outputFormat,
            PendingPlan = _pendingPlan,
            Progress = _progress,
            Telemetry = _telemetry,
            ActiveJobId = _activeJobId,
            IsBusy = _isBusy,
            IsCancelling = _isCancelling,
            PlanStatusMessage = _planStatusMessage,
            ChatError = _chatError,
            ExecutionPanelCollapsed = _executionPanelCollapsed,
            ExecutionPanelWidth = _executionPanelWidth
        });
    }

    private void MirrorProgressMessagesToActivity(ChatProgressRecord progress)
    {
        if (!progress.Messages.Any())
        {
            return;
        }

        _chatActivityId ??= ActivityLog.Begin("Copilot", "Chat request", $"Restored chat progress: {TrimForActivity(progress.Prompt)}");
        foreach (var message in progress.Messages.OrderBy(message => message.Timestamp))
        {
            var key = $"{progress.JobId:N}|{message.Timestamp:O}|{message.Stage}|{message.Message}";
            if (!_loggedProgressMessages.Add(key))
            {
                continue;
            }

            ActivityLog.Trace(_chatActivityId.Value, "Copilot", message.Stage, message.Message);
        }

        if (progress.Status == ChatJobStatus.Succeeded)
        {
            ActivityLog.Complete(_chatActivityId.Value, "Copilot", "Chat completed", "Background chat execution completed.");
        }
        else if (progress.Status == ChatJobStatus.Failed)
        {
            ActivityLog.Fail(_chatActivityId.Value, "Copilot", "Chat failed", progress.Error ?? "Background chat execution failed.");
        }
        else if (progress.Status == ChatJobStatus.Cancelled)
        {
            ActivityLog.Warn(_chatActivityId.Value, "Copilot", "Chat cancelled", progress.Error ?? "Background chat execution was cancelled.");
        }
    }

    private static ChatJobSnapshot ToChatJobSnapshot(ChatProgressRecord progress)
    {
        var latestHeartbeat = progress.Heartbeats
            .OrderByDescending(heartbeat => heartbeat.Timestamp)
            .FirstOrDefault();

        var latestStep = progress.Steps
            .OrderByDescending(step => step.Status == ChatProgressStepStatus.Running)
            .ThenByDescending(step => step.Order)
            .FirstOrDefault();

        return new ChatJobSnapshot
        {
            JobId = progress.JobId,
            PlanId = progress.PlanId,
            Prompt = progress.Prompt,
            Status = progress.Status,
            Stage = latestHeartbeat?.Stage ?? latestStep?.Name ?? "Chat",
            PercentComplete = progress.PercentComplete,
            Detail = latestHeartbeat?.Detail ?? latestStep?.Detail ?? progress.PartialResult ?? string.Empty,
            CreatedAt = progress.CreatedAt,
            StartedAt = progress.StartedAt,
            LastHeartbeatAt = latestHeartbeat?.Timestamp ?? progress.CompletedAt ?? progress.StartedAt ?? progress.CreatedAt,
            CompletedAt = progress.CompletedAt,
            Result = progress.FinalResult,
            Error = progress.Error
        };
    }

    private static string TrimForActivity(string value)
    {
        const int maxLength = 220;
        var compact = value.Replace("\r", " ", StringComparison.Ordinal).Replace("\n", " ", StringComparison.Ordinal).Trim();
        return compact.Length <= maxLength ? compact : $"{compact[..maxLength]}...";
    }

    private static MarkupString RenderMarkdown(string content)
    {
        if (string.IsNullOrWhiteSpace(content))
        {
            return new MarkupString(string.Empty);
        }

        var trimmed = content.Trim();
        if (trimmed.StartsWith("{", StringComparison.Ordinal) || trimmed.StartsWith("[", StringComparison.Ordinal))
        {
            return new MarkupString($"<pre class=\"copilot-json\">{HtmlEncoder.Default.Encode(trimmed)}</pre>");
        }

        var lines = content
            .Replace("\r\n", "\n", StringComparison.Ordinal)
            .Replace('\r', '\n')
            .Split('\n');
        var html = new StringBuilder();

        for (var i = 0; i < lines.Length;)
        {
            var line = lines[i];
            if (string.IsNullOrWhiteSpace(line))
            {
                i++;
                continue;
            }

            if (IsTableStart(lines, i))
            {
                i = AppendTable(html, lines, i);
                continue;
            }

            if (TryAppendHeading(html, line))
            {
                i++;
                continue;
            }

            if (IsListItem(line))
            {
                i = AppendList(html, lines, i);
                continue;
            }

            i = AppendParagraph(html, lines, i);
        }

        return new MarkupString(html.ToString());
    }

    private static bool IsTableStart(string[] lines, int index)
    {
        return index + 1 < lines.Length
            && lines[index].Contains('|', StringComparison.Ordinal)
            && Regex.IsMatch(lines[index + 1], @"^\s*\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)+\|?\s*$");
    }

    private static int AppendTable(StringBuilder html, string[] lines, int index)
    {
        var headers = SplitTableRow(lines[index]);
        html.Append("<div class=\"copilot-table-wrap\"><table class=\"table table-sm table-bordered copilot-table\"><thead><tr>");
        foreach (var header in headers)
        {
            html.Append("<th>").Append(RenderInline(header)).Append("</th>");
        }

        html.Append("</tr></thead><tbody>");
        index += 2;
        while (index < lines.Length && lines[index].Contains('|', StringComparison.Ordinal) && !string.IsNullOrWhiteSpace(lines[index]))
        {
            html.Append("<tr>");
            foreach (var cell in SplitTableRow(lines[index]))
            {
                html.Append("<td>").Append(RenderInline(cell)).Append("</td>");
            }

            html.Append("</tr>");
            index++;
        }

        html.Append("</tbody></table></div>");
        return index;
    }

    private static IReadOnlyList<string> SplitTableRow(string line)
    {
        return line.Trim().Trim('|').Split('|').Select(cell => cell.Trim()).ToList();
    }

    private static bool TryAppendHeading(StringBuilder html, string line)
    {
        var trimmed = line.TrimStart();
        var level = trimmed.TakeWhile(c => c == '#').Count();
        if (level is < 1 or > 4 || trimmed.Length <= level || trimmed[level] != ' ')
        {
            return false;
        }

        html.Append("<h").Append(level).Append('>')
            .Append(RenderInline(trimmed[(level + 1)..]))
            .Append("</h").Append(level).Append('>');
        return true;
    }

    private static bool IsListItem(string line)
    {
        var trimmed = line.TrimStart();
        return trimmed.StartsWith("- ", StringComparison.Ordinal) || trimmed.StartsWith("* ", StringComparison.Ordinal);
    }

    private static int AppendList(StringBuilder html, string[] lines, int index)
    {
        html.Append("<ul>");
        while (index < lines.Length && IsListItem(lines[index]))
        {
            html.Append("<li>").Append(RenderInline(lines[index].TrimStart()[2..])).Append("</li>");
            index++;
        }

        html.Append("</ul>");
        return index;
    }

    private static int AppendParagraph(StringBuilder html, string[] lines, int index)
    {
        var paragraph = new List<string>();
        while (index < lines.Length
            && !string.IsNullOrWhiteSpace(lines[index])
            && !IsTableStart(lines, index)
            && !IsListItem(lines[index])
            && !lines[index].TrimStart().StartsWith("# ", StringComparison.Ordinal)
            && !lines[index].TrimStart().StartsWith("## ", StringComparison.Ordinal))
        {
            paragraph.Add(lines[index].Trim());
            index++;
        }

        html.Append("<p>").Append(RenderInline(string.Join(" ", paragraph))).Append("</p>");
        return index;
    }

    private static string RenderInline(string value)
    {
        var encoded = HtmlEncoder.Default.Encode(value);
        encoded = Regex.Replace(encoded, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        encoded = Regex.Replace(encoded, @"`(.+?)`", "<code>$1</code>");
        return encoded;
    }
}
