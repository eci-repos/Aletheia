{
  "Logging": {
    "Aletheia.RAGS": "Debug",
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Jwt": {
      "Secret": "development-jwt-secret-that-is-at-least-32-characters"
    }
  },
  "ConnectionStrings": {
    "PostgreSQL": "Host=postgres;Port=5432;Database=aletheia;Username=aletheia;Password=aletheia"
  },
  "AI": {
    "DefaultProvider": "LocalOllama",
    "EmbeddingProvider": "Simple",
    "EmbeddingDimension": 768,
    "Providers": [
      {
        "Name": "LocalOllama",
        "Type": "Ollama",
        "Enabled": true,
        "Endpoint": "http://localhost:11434",
        "DefaultModel": "gpt-oss:120b-cloud",
        "ContextLength": 128000,
        "MaxOutputTokens": 8192,
        "RequestTimeoutSeconds": 300,
        "BatchSize": 1
        "EmbeddingModel": "nomic-embed-text",
      }
    ]
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "BucketName": "aletheia-files"
  },
  "ChatAgent": {
    "Role": "You are Aletheia, a research assistant for an organizational document repository.",
    "RepositoryDescription": "The repository contains documents that identify projects, efforts, RFPs, as-built recollections, activities descriptions, requirements, rules or mandates, planning, scheduling efforts, working or development teams, and other entities.",
    "Mandate": "Always ground your answers in documents retrieved from the repository. If the repository does not contain relevant information, say so explicitly instead of inventing an answer.",
    "NoInformationResponse": "I could not find relevant information in the repository for that question.",
    "OrchestrationScriptPath": "Prompts/copilot-rags-orchestration.md",
    "ToolNames": {
      "SearchRepository": "AletheiaKnowledgePlugin.SearchRags",
      "SearchRepositoryFallback": "RepositoryTool.SearchRepositoryDocuments"
    },
    "BehaviorFlags": {
      "RequireRepositoryLookupBeforeAnswer": true,
      "CiteSources": true,
      "RefuseWhenNoContext": false,
      "IncludeRepositorySummaryInPrompt": true
    }
  },
  "Copilot": {
    "RetrievalTopK": 8,
    "KnowledgeAliases": {
      "cmp": [
        "Cleveland Metroparks"
      ]
    },
    "DefaultAreas": [
      "scope",
      "requirements",
      "activities",
      "deliverables",
      "timeline",
      "pricing",
      "compliance",
      "risks"
    ],
    "DefaultAnswerProfile": "rfp_requirements",
    "AnswerProfiles": {
      "rfp_requirements": {
        "MatchTerms": [
          "rfp",
          "requirements",
          "activities"
        ],
        "Areas": [
          "scope",
          "activities",
          "requirements",
          "deliverables",
          "responsibilities",
          "timeline",
          "pricing",
          "compliance"
        ],
        "OutputFormat": "Markdown with a short summary followed by a table with columns: Area, Requirement, Evidence, Citation",
        "RequireCitations": true,
        "Instructions": [
          "Prefer exact requirements found in the retrieved context over general RFP guidance.",
          "If an area is not present in the retrieved context, mark it as not found instead of guessing."
        ]
      }
    }
  },
  "ChatExecutionEngine": {
    "DefaultStepTimeoutSeconds": 30,
    "MandatoryToolTimeoutSeconds": 180,
    "OverallJobTimeoutSeconds": 600,
    "HeartbeatIntervalSeconds": 10,
    "LongWaitHeartbeatIntervalSeconds": 30,
    "HeartbeatWatchdogMissedThreshold": 6,
    "MaxConcurrentChatJobs": 3,
    "SmallCorpusDocumentThreshold": 5,
    "SmallCorpusTimeoutSeconds": 5,
    "HydrationTimeoutSeconds": 30
  },
  "PgVector": {
    "ConnectionString": "Host=localhost;Port=5432;Database=aletheia;Username=postgres;Password=postgres",
    "CommandTimeoutSeconds": 30,
    "VectorIndexType": "hnsw"
  },
  "AllowedHosts": "*",
  "FeatureFlags": {
    "ShowInternalSearch": false
  },
  "Taxonomy": {
  "RAGS": {
    "MinimumScore": 0
  },
    "StopWords": ["a","an","the","and","or","but","if","while","for","to","of","in","on","by","as","at","from","into","that","this","it","is","was","were","be","been","being","has","have","had","not","no","yes"]
  }
}



