{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AI": {
    "DefaultProvider": "LocalOllama",
    "Providers": [
      {
        "Name": "LocalOllama",
        "Type": "Ollama",
        "Enabled": true,
        "Endpoint": "http://localhost:11434",
        "DefaultModel": "kimi-k2.7-code:cloud"
      }
    ]
  },
  "Copilot": {
    "RetrievalTopK": 8,
    "KnowledgeAliases": {
      "cmp": [
        "Cleveland Metroparks"
      ]
    },
    "DefaultAreas": [
      "scope",
      "requirements",
      "activities",
      "deliverables",
      "timeline",
      "pricing",
      "compliance",
      "risks"
    ],
    "DefaultAnswerProfile": "rfp_requirements",
    "AnswerProfiles": {
      "rfp_requirements": {
        "MatchTerms": [
          "rfp",
          "requirements",
          "activities"
        ],
        "Areas": [
          "scope",
          "activities",
          "requirements",
          "deliverables",
          "responsibilities",
          "timeline",
          "pricing",
          "compliance"
        ],
        "OutputFormat": "Markdown with a short summary followed by a table with columns: Area, Requirement, Evidence, Citation",
        "RequireCitations": true,
        "Instructions": [
          "Prefer exact requirements found in the retrieved context over general RFP guidance.",
          "If an area is not present in the retrieved context, mark it as not found instead of guessing."
        ]
      }
    }
  },
  "AllowedHosts": "*"
}
