# Aletheia Environment Configuration
# Copy this file to .env and fill in production values.
# Never commit .env to version control.

# PostgreSQL
POSTGRES_USER=aletheia
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=aletheia

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-production

# Neo4j
NEO4J_AUTH=neo4j/change-me-in-production

# Application
ASPNETCORE_ENVIRONMENT=Production
Cors__AllowedOrigins__0=https://localhost:5001
ALETHEIA_JWT_SECRET=change-me-to-at-least-32-random-characters
ALETHEIA_ADMIN_PASSWORD=change-me-to-a-strong-admin-password

# Connection Strings
ConnectionStrings__PostgreSQL=Host=postgres;Port=5432;Database=aletheia;Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}

# MinIO Client
MinIO__Endpoint=minio:9000
MinIO__AccessKey=${MINIO_ROOT_USER}
MinIO__SecretKey=${MINIO_ROOT_PASSWORD}
MinIO__BucketName=aletheia-files

# Neo4j Client
Neo4j__Uri=bolt://neo4j:7687
Neo4j__Username=neo4j
Neo4j__Password=change-me-in-production

# AI / Semantic Kernel
AI__DefaultProvider=LocalOllama
AI__Providers__0__Name=LocalOllama
AI__Providers__0__Type=Ollama
AI__Providers__0__Enabled=true
AI__Providers__0__Endpoint=http://host.docker.internal:11434
AI__Providers__0__DefaultModel=kimi-k2.7-code:cloud
