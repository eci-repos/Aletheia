@implements IDisposable
@using System.Text
@inject ActivityLogService ActivityLog
@inject RepositoryApiClient ApiClient
@inject IJSRuntime JS

<aside class="activity-panel @(isOpen ? "open" : "collapsed")" aria-label="Activity log">
    <button class="activity-toggle" type="button" @onclick="Toggle" aria-expanded="@isOpen" aria-label="Toggle activity log">
        <span>Activity</span>
        @if (ActivityLog.RunningCount > 0)
        {
            <span class="activity-count">@ActivityLog.RunningCount</span>
        }
    </button>

    @if (isOpen)
    {
        <div class="activity-shell">
            <div class="activity-header">
                <div>
                    <h2>Activity</h2>
                    <div class="activity-subtitle">@Subtitle</div>
                </div>
                <div class="activity-actions">
                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="CopyAllTraceAsync" disabled="@(!ActivityLog.Entries.Any() && !ActivityLog.Jobs.Any())">
                        Copy all
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="ActivityLog.Clear" disabled="@(!ActivityLog.Entries.Any())">
                        Clear
                    </button>
                </div>
            </div>
            @if (!string.IsNullOrWhiteSpace(copyStatus))
            {
                <div class="activity-copy-status">@copyStatus</div>
            }

            <div class="activity-list">
                @if (ActivityLog.Jobs.Any())
                {
                    <div class="job-section-title">Jobs</div>
                    @foreach (var job in ActivityLog.Jobs)
                    {
                        <div class="job-card @JobStatusCss(job.Status)">
                            <div class="job-card-top">
                                <span class="job-status">@job.Status</span>
                                <time>@FormatHeartbeat(job.LastHeartbeatAt)</time>
                            </div>
                            <div class="job-card-actions">
                                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => CopyJobTraceAsync(job)">
                                    Copy trace
                                </button>
                            </div>
                            <div class="job-title">@job.Title</div>
                            <div class="job-stage">@job.Stage</div>
                            <div class="job-progress" aria-label="Job progress">
                                <div class="job-progress-bar" style="width: @Math.Clamp(job.PercentComplete, 0, 100)%"></div>
                            </div>
                            <div class="job-detail">@job.PercentComplete% · @job.Detail</div>
                            @if (!string.IsNullOrWhiteSpace(job.Error))
                            {
                                <div class="job-error">@job.Error</div>
                            }
                        </div>
                    }
                }

                @if (!ActivityLog.Entries.Any() && !ActivityLog.Jobs.Any())
                {
                    <div class="activity-empty">No activity yet.</div>
                }
                else if (ActivityLog.Entries.Any())
                {
                    <div class="job-section-title">Trace</div>
                    @foreach (var entry in ActivityLog.Entries)
                    {
                        <div class="activity-entry @StatusCss(entry.Status)">
                            <div class="activity-entry-top">
                                <span class="activity-status">@StatusText(entry.Status)</span>
                                <time>@entry.Timestamp.ToString("HH:mm:ss")</time>
                            </div>
                            <div class="activity-entry-title">@entry.Title</div>
                            <div class="activity-entry-area">@entry.Area</div>
                            <div class="activity-entry-message">@entry.Message</div>
                        </div>
                    }
                }
            </div>
        </div>
    }
</aside>

@code {
    private bool isOpen;
    private Timer? timer;
    private bool polling;
    private string copyStatus = string.Empty;

    private string Subtitle => ActivityLog.RunningCount == 0
        ? $"{ActivityLog.Jobs.Count} jobs · {ActivityLog.Entries.Count} events"
        : $"{ActivityLog.RunningCount} running · {ActivityLog.Jobs.Count} jobs · {ActivityLog.Entries.Count} events";

    protected override void OnInitialized()
    {
        ActivityLog.Changed += OnActivityChanged;
        timer = new Timer(_ => _ = InvokeAsync(PollJobsAsync), null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(10));
    }

    private void Toggle()
    {
        isOpen = !isOpen;
    }

    private void OnActivityChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task CopyAllTraceAsync()
    {
        var text = BuildTraceText(null);
        await JS.InvokeVoidAsync("aletheia.copyText", text);
        copyStatus = "Trace copied.";
        _ = Task.Run(async () =>
        {
            await Task.Delay(TimeSpan.FromSeconds(2));
            await InvokeAsync(() =>
            {
                copyStatus = string.Empty;
                StateHasChanged();
            });
        });
    }

    private async Task CopyJobTraceAsync(BackgroundJobClientSnapshot job)
    {
        var text = BuildTraceText(job);
        await JS.InvokeVoidAsync("aletheia.copyText", text);
        copyStatus = $"Trace copied for {job.Title}.";
        _ = Task.Run(async () =>
        {
            await Task.Delay(TimeSpan.FromSeconds(2));
            await InvokeAsync(() =>
            {
                copyStatus = string.Empty;
                StateHasChanged();
            });
        });
    }

    private async Task PollJobsAsync()
    {
        if (polling)
        {
            return;
        }

        polling = true;
        try
        {
            var jobs = await ApiClient.GetIngestionJobsAsync(25);
            if (jobs is not null)
            {
                foreach (var job in jobs)
                {
                    ActivityLog.UpsertJob(job);
                }
            }

            var chatJobs = await ApiClient.GetChatJobsAsync(25);
            if (chatJobs is not null)
            {
                foreach (var chatJob in chatJobs)
                {
                    ActivityLog.UpsertChatJob(chatJob);
                }
            }
        }
        catch
        {
        }
        finally
        {
            polling = false;
            StateHasChanged();
        }
    }

    private static string StatusCss(ActivityLogStatus status) => status switch
    {
        ActivityLogStatus.Running => "running",
        ActivityLogStatus.Success => "success",
        ActivityLogStatus.Warning => "warning",
        ActivityLogStatus.Error => "error",
        _ => "info"
    };

    private static string StatusText(ActivityLogStatus status) => status switch
    {
        ActivityLogStatus.Running => "running",
        ActivityLogStatus.Success => "done",
        ActivityLogStatus.Warning => "notice",
        ActivityLogStatus.Error => "error",
        _ => "trace"
    };

    private static string JobStatusCss(string status) => status switch
    {
        "Queued" or "Running" => "running",
        "Succeeded" => "success",
        "Failed" => "error",
        "Cancelled" => "warning",
        _ => "info"
    };

    private static string FormatHeartbeat(DateTimeOffset heartbeat)
    {
        var elapsed = DateTimeOffset.UtcNow - heartbeat;
        if (elapsed.TotalSeconds < 60)
        {
            return $"{Math.Max(0, (int)elapsed.TotalSeconds)}s ago";
        }

        return $"{(int)elapsed.TotalMinutes}m ago";
    }

    private string BuildTraceText(BackgroundJobClientSnapshot? selectedJob)
    {
        var builder = new StringBuilder();
        builder.AppendLine("Aletheia Activity Trace");
        builder.AppendLine($"Generated: {DateTimeOffset.Now:O}");
        builder.AppendLine();

        var jobs = selectedJob is null
            ? ActivityLog.Jobs
            : new[] { selectedJob };
        var entries = selectedJob is null
            ? ActivityLog.Entries
            : ActivityLog.Entries
                .Where(entry => entry.ActivityId == selectedJob.JobId
                    || entry.Message.Contains(selectedJob.JobId.ToString(), StringComparison.OrdinalIgnoreCase)
                    || entry.Message.Contains(selectedJob.JobId.ToString("N"), StringComparison.OrdinalIgnoreCase))
                .ToList();

        if (jobs.Any())
        {
            builder.AppendLine("Jobs");
            foreach (var job in jobs)
            {
                builder.AppendLine($"- [{job.Status}] {job.Title}");
                builder.AppendLine($"  JobId: {job.JobId}");
                builder.AppendLine($"  Kind: {job.Kind}");
                builder.AppendLine($"  Stage: {job.Stage}");
                builder.AppendLine($"  Progress: {job.PercentComplete}%");
                builder.AppendLine($"  Detail: {job.Detail}");
                if (!string.IsNullOrWhiteSpace(job.Error))
                {
                    builder.AppendLine($"  Error: {job.Error}");
                }

                builder.AppendLine($"  Created: {job.CreatedAt:O}");
                builder.AppendLine($"  LastHeartbeat: {job.LastHeartbeatAt:O}");
                builder.AppendLine();
            }
        }

        if (entries.Any())
        {
            builder.AppendLine("Trace");
            foreach (var entry in entries.OrderBy(entry => entry.Timestamp))
            {
                builder.AppendLine($"- [{StatusText(entry.Status)}] {entry.Timestamp:HH:mm:ss} {entry.Title} ({entry.Area})");
                builder.AppendLine($"  {entry.Message}");
            }
        }

        return builder.ToString();
    }

    public void Dispose()
    {
        ActivityLog.Changed -= OnActivityChanged;
        timer?.Dispose();
    }
}
