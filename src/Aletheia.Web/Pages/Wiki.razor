@page "/wiki"
@inject RepositoryApiClient ApiClient
@inject ActivityLogService ActivityLog
@inject AuthService Auth

<PageTitle>WRAGS Wiki - Aletheia</PageTitle>

<div class="wiki-page">
    <div class="wiki-header">
        <div>
            <h1>WRAGS Wiki</h1>
            <div class="text-muted">Wiki Retrieval Augmented Generation System</div>
        </div>
        <div class="wiki-mode btn-group" role="group" aria-label="Wiki retrieval mode">
            <button type="button" class="btn @ModeButtonClass("wrags")" @onclick='() => SetMode("wrags")'>WRAGS</button>
            <button type="button" class="btn @ModeButtonClass("graphrag")" @onclick='() => SetMode("graphrag")'>GraphRAG</button>
            <button type="button" class="btn @ModeButtonClass("lazygraphrag")" @onclick='() => SetMode("lazygraphrag")'>Lazy</button>
            <button type="button" class="btn @ModeButtonClass("semantic")" @onclick='() => SetMode("semantic")'>Semantic</button>
        </div>
    </div>

    <div class="wiki-search input-group">
        <input type="text" class="form-control" placeholder="Search wiki topics..." @bind="_query" @bind:event="oninput" @onkeydown="HandleKeyDown" />
        <button class="btn btn-primary" @onclick="SearchAsync" disabled="@_searching">Search</button>
    </div>

    <div class="wiki-controls">
        <label class="form-label">
            Pages: @_topK
            <input type="range" class="form-range" min="1" max="12" @bind="_topK" />
        </label>
        @if (_mode is "wrags" or "graphrag" or "lazygraphrag")
        {
            <label class="form-label">
                Expansion: @_expansion
                <input type="range" class="form-range" min="0" max="3" @bind="_expansion" />
            </label>
        }
    </div>

    @if (_searching)
    {
        <div class="alert alert-info">Searching WRAGS...</div>
    }

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }

    @if (_pages is not null)
    {
        @if (_pages.Count == 0)
        {
            <div class="alert alert-warning">No wiki pages found.</div>
        }
        else
        {
            <div class="wiki-layout">
                <aside class="wiki-index" aria-label="Wiki pages">
                    @foreach (var wikiPage in _pages)
                    {
                        <button type="button" class="wiki-index-item @(wikiPage == _selectedPage ? "is-selected" : "")" @onclick="() => SelectPageAsync(wikiPage)">
                            <span>@wikiPage.Title</span>
                            <small>@wikiPage.GeneratedFrom · v@wikiPage.Version · @wikiPage.Status</small>
                        </button>
                    }
                </aside>

                @if (_selectedPage is not null)
                {
                    <section class="wiki-article">
                        <div class="wiki-article-header">
                            <div>
                                <h2>@_selectedPage.Title</h2>
                                <div class="wiki-meta">
                                    <span>Rank @_selectedPage.Rank</span>
                                    <span>@_selectedPage.Score.ToString("P1")</span>
                                    <span>@_selectedPage.RetrievalStrategy</span>
                                    <span>v@_selectedPage.Version</span>
                                    <span>@_selectedPage.Status</span>
                                    @if (_selectedPage.IsStale)
                                    {
                                        <span>Stale</span>
                                    }
                                </div>
                            </div>
                            <div class="wiki-actions">
                                <button type="button" class="btn btn-outline-success btn-sm" @onclick='() => UpdateStatusAsync("Reviewed")' disabled="@_searching">Reviewed</button>
                                <button type="button" class="btn btn-outline-success btn-sm" @onclick='() => UpdateStatusAsync("Approved")' disabled="@_searching">Approve</button>
                                <button type="button" class="btn btn-outline-warning btn-sm" @onclick='() => UpdateStatusAsync("NeedsReview")' disabled="@_searching">Needs review</button>
                                <button type="button" class="btn btn-outline-danger btn-sm" @onclick='() => UpdateStatusAsync("Stale")' disabled="@_searching">Stale</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="BeginEdit" disabled="@_searching">Edit</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="RegenerateAsync" disabled="@_searching">Queue regen</button>
                            </div>
                        </div>

                        @if (_selectedPage.IsStale && !string.IsNullOrWhiteSpace(_selectedPage.StaleReason))
                        {
                            <div class="alert alert-warning py-2">@_selectedPage.StaleReason</div>
                        }

                        @if (_editing)
                        {
                            <div class="wiki-editor">
                                <label class="form-label">
                                    Title
                                    <input class="form-control" @bind="_editTitle" />
                                </label>
                                <label class="form-label">
                                    Body
                                    <textarea class="form-control" rows="10" @bind="_editSummary"></textarea>
                                </label>
                                <label class="form-label">
                                    Related topics
                                    <input class="form-control" placeholder="Comma-separated topics" @bind="_editTopics" />
                                </label>
                                <label class="form-label">
                                    Change note
                                    <input class="form-control" @bind="_editNote" />
                                </label>
                                <div class="wiki-actions">
                                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveEditAsync" disabled="@_searching">Save</button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit" disabled="@_searching">Cancel</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="wiki-summary">@_selectedPage.Summary</p>
                        }

                        @if (_selectedPage.RelatedTopics.Count > 0)
                        {
                            <div class="wiki-section">
                                <h3>Related Topics</h3>
                                <div class="wiki-topic-list">
                                    @foreach (var topic in _selectedPage.RelatedTopics)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SearchTopicAsync(topic)">@topic</button>
                                    }
                                </div>
                            </div>
                        }

                        @if (_relatedPages.Count > 0)
                        {
                            <div class="wiki-section">
                                <h3>Backlinks</h3>
                                <ul class="wiki-list">
                                    @foreach (var related in _relatedPages)
                                    {
                                        <li>
                                            <button type="button" class="btn btn-link p-0 align-baseline" @onclick="() => SearchTopicAsync(related.Topic)">@related.Title</button>
                                            <span class="text-muted small"> · @related.Status · v@related.Version</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (_history.Count > 0)
                        {
                            <div class="wiki-section">
                                <h3>History</h3>
                                <ul class="wiki-list">
                                    @foreach (var item in _history)
                                    {
                                        <li>
                                            <strong>v@item.Version</strong>
                                            <span class="text-muted small"> · @item.ChangeType · @item.Status · @item.CreatedAt.ToLocalTime().ToString("g")</span>
                                            @if (!string.IsNullOrWhiteSpace(item.ChangeNote))
                                            {
                                                <div class="small">@item.ChangeNote</div>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (_selectedPage.Citations.Count > 0)
                        {
                            <div class="wiki-section">
                                <h3>Citations</h3>
                                <ul class="wiki-list">
                                    @foreach (var citation in _selectedPage.Citations)
                                    {
                                        <li>@citation</li>
                                    }
                                </ul>
                            </div>
                        }

                        <div class="wiki-section">
                            <h3>Source</h3>
                            <dl class="wiki-source">
                                <dt>Source ID</dt>
                                <dd>@(_selectedPage.PrimarySourceId?.ToString() ?? string.Join(", ", _selectedPage.SourceIds))</dd>
                                <dt>Chunk</dt>
                                <dd>@(_selectedPage.ChunkIndex?.ToString() ?? "n/a")</dd>
                                <dt>Updated</dt>
                                <dd>@_selectedPage.UpdatedAt.ToLocalTime().ToString("g")</dd>
                                <dt>Reviewed</dt>
                                <dd>@ReviewedText(_selectedPage)</dd>
                            </dl>
                        </div>
                    </section>
                }
            </div>
        }
    }
</div>

@code {
    private string _query = string.Empty;
    private string _mode = "wrags";
    private int _topK = 6;
    private int _expansion = 1;
    private bool _searching;
    private string _error = string.Empty;
    private List<WikiPage>? _pages;
    private WikiPage? _selectedPage;
    private List<WikiPageLink> _relatedPages = new();
    private List<WikiPageHistoryEntry> _history = new();
    private bool _editing;
    private string _editTitle = string.Empty;
    private string _editSummary = string.Empty;
    private string _editTopics = string.Empty;
    private string _editNote = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var recent = await ApiClient.GetRecentWikiPagesAsync(20);
            _pages = recent?.ToList();
            _selectedPage = _pages?.FirstOrDefault();
            await LoadRelatedPagesAsync();
            await LoadHistoryAsync();
        }
        catch (Exception ex)
        {
            HandleError(ex);
        }
    }

    private string ModeButtonClass(string mode) => _mode == mode ? "btn-primary" : "btn-outline-primary";

    private void SetMode(string mode)
    {
        _mode = mode;
        _pages = null;
        _selectedPage = null;
        _history = new List<WikiPageHistoryEntry>();
        _editing = false;
        _error = string.Empty;
    }

    private async Task SelectPageAsync(WikiPage page)
    {
        _selectedPage = page;
        _editing = false;
        await LoadRelatedPagesAsync();
        await LoadHistoryAsync();
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_query))
        {
            return;
        }

        var activityId = ActivityLog.Begin("WRAGS Wiki", $"{_mode.ToUpperInvariant()} wiki search", $"Searching for \"{_query}\".");
        _searching = true;
        _error = string.Empty;
        _pages = null;
        _selectedPage = null;

        try
        {
            var results = await ApiClient.SearchWikiAsync(BuildRequest(regenerate: false));
            _pages = results?.ToList() ?? new List<WikiPage>();
            _selectedPage = _pages.FirstOrDefault();
            await LoadRelatedPagesAsync();
            await LoadHistoryAsync();
            ActivityLog.Complete(activityId, "WRAGS Wiki", $"{_mode.ToUpperInvariant()} wiki search", $"Wiki search completed with {_pages.Count} pages.");
        }
        catch (Exception ex)
        {
            _pages = new List<WikiPage>();
            HandleError(ex);
            ActivityLog.Fail(activityId, "WRAGS Wiki", $"{_mode.ToUpperInvariant()} wiki search", _error);
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task RegenerateAsync()
    {
        if (string.IsNullOrWhiteSpace(_query) && _selectedPage is not null)
        {
            _query = _selectedPage.Topic;
        }

        if (string.IsNullOrWhiteSpace(_query))
        {
            return;
        }

        var activityId = ActivityLog.Begin("WRAGS Wiki", $"{_mode.ToUpperInvariant()} wiki regeneration", $"Queueing regeneration for \"{_query}\".");
        _searching = true;
        _error = string.Empty;

        try
        {
            var job = await ApiClient.RegenerateWikiJobAsync(BuildRequest(regenerate: true));
            if (job is not null)
            {
                ActivityLog.UpsertJob(job);
                ActivityLog.Complete(activityId, "WRAGS Wiki", $"{_mode.ToUpperInvariant()} wiki regeneration", $"Background job {job.JobId:N} queued.");
            }
            else
            {
                ActivityLog.Fail(activityId, "WRAGS Wiki", $"{_mode.ToUpperInvariant()} wiki regeneration", "Regeneration API did not return a job.");
            }
        }
        catch (Exception ex)
        {
            HandleError(ex);
            ActivityLog.Fail(activityId, "WRAGS Wiki", $"{_mode.ToUpperInvariant()} wiki regeneration", _error);
        }
        finally
        {
            _searching = false;
        }
    }

    private WikiSearchRequest BuildRequest(bool regenerate)
        => new()
        {
            Query = _query,
            Mode = _mode,
            TopK = _topK,
            Expansion = _expansion,
            Regenerate = regenerate
        };

    private async Task UpdateStatusAsync(string status)
    {
        if (_selectedPage is null)
        {
            return;
        }

        _searching = true;
        _error = string.Empty;

        try
        {
            var updated = await ApiClient.UpdateWikiPageStatusAsync(_selectedPage.Id, new WikiPageStatusUpdate(status));
            if (updated is not null)
            {
                _selectedPage = updated;
                _editing = false;
                if (_pages is not null)
                {
                    var index = _pages.FindIndex(page => page.Id == updated.Id);
                    if (index >= 0)
                    {
                        _pages[index] = updated;
                    }
                }
                await LoadHistoryAsync();
            }
        }
        catch (Exception ex)
        {
            HandleError(ex);
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task SearchTopicAsync(string topic)
    {
        _query = topic;
        await SearchAsync();
    }

    private void BeginEdit()
    {
        if (_selectedPage is null)
        {
            return;
        }

        _editTitle = _selectedPage.Title;
        _editSummary = _selectedPage.Summary;
        _editTopics = string.Join(", ", _selectedPage.RelatedTopics);
        _editNote = string.Empty;
        _editing = true;
    }

    private void CancelEdit()
    {
        _editing = false;
        _editTitle = string.Empty;
        _editSummary = string.Empty;
        _editTopics = string.Empty;
        _editNote = string.Empty;
    }

    private async Task SaveEditAsync()
    {
        if (_selectedPage is null)
        {
            return;
        }

        _searching = true;
        _error = string.Empty;

        try
        {
            var updated = await ApiClient.UpdateWikiPageAsync(
                _selectedPage.Id,
                new WikiPageEditRequest
                {
                    Title = _editTitle,
                    Summary = _editSummary,
                    RelatedTopics = _editTopics
                        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                        .ToList(),
                    Status = "NeedsReview",
                    ChangeNote = _editNote
                });

            if (updated is not null)
            {
                _selectedPage = updated;
                _editing = false;
                if (_pages is not null)
                {
                    var index = _pages.FindIndex(page => page.Id == updated.Id);
                    if (index >= 0)
                    {
                        _pages[index] = updated;
                    }
                }

                await LoadHistoryAsync();
                await LoadRelatedPagesAsync();
            }
        }
        catch (Exception ex)
        {
            HandleError(ex);
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task LoadRelatedPagesAsync()
    {
        _relatedPages = new List<WikiPageLink>();
        if (_selectedPage is null)
        {
            return;
        }

        try
        {
            var related = await ApiClient.GetRelatedWikiPagesAsync(_selectedPage.Id, 10);
            _relatedPages = related?.ToList() ?? new List<WikiPageLink>();
        }
        catch
        {
            _relatedPages = new List<WikiPageLink>();
        }
    }

    private async Task LoadHistoryAsync()
    {
        _history = new List<WikiPageHistoryEntry>();
        if (_selectedPage is null)
        {
            return;
        }

        try
        {
            var history = await ApiClient.GetWikiPageHistoryAsync(_selectedPage.Id, 20);
            _history = history?.ToList() ?? new List<WikiPageHistoryEntry>();
        }
        catch
        {
            _history = new List<WikiPageHistoryEntry>();
        }
    }

    private void HandleError(Exception ex)
    {
        _error = ex.Message;
    }

    private static string ReviewedText(WikiPage page)
    {
        if (string.IsNullOrWhiteSpace(page.ReviewedBy) || page.ReviewedAt is null)
        {
            return "n/a";
        }

        return $"{page.ReviewedBy} at {page.ReviewedAt.Value.ToLocalTime():g}";
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

}
