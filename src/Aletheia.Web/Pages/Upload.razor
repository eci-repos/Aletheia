@page "/upload"
@inject RepositoryApiClient ApiClient
@inject ActivityLogService ActivityLog
@inject RecentGraphContextService RecentGraphContext
@inject NavigationManager Navigation

<PageTitle>Upload - Aletheia</PageTitle>

<h1>Upload Files</h1>

@if (_updateFileId.HasValue)
{
    <div class="alert alert-primary">
        <strong>Update mode:</strong> the file you select will replace <em>@_updateFileName</em> as a new version of that
        document. The existing document keeps its identity, prior versions stay in its history, and search/Wiki content is replaced after ingestion.
    </div>
}
else
{
    <div class="alert alert-info">
        Uploads are processed in the background. When a file finishes ingesting you will see its status change to
        <strong>Ready</strong> and a notification entry in the Activity panel — at that point the document is searchable
        and a Wiki brief is generated automatically.
    </div>
}

@if (_notice is not null)
{
    <div class="alert @_notice.Value.Class">@_notice.Value.Text</div>
}

<div class="upload-container">
    <InputFile OnChange="LoadFiles" class="form-control" multiple />

    @if (_filesToUpload.Any())
    {
        <ul class="list-group mt-3">
            @foreach (var file in _filesToUpload)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    @file.Name (@file.Size bytes)
                    @if (_statuses.TryGetValue(file.Name, out var status))
                    {
                        <span class="badge @status.Class">@status.Text</span>
                    }
                </li>
            }
        </ul>

        <button class="btn btn-primary mt-3" @onclick="UploadFilesAsync" disabled="@_isUploading">
            @(_isUploading ? "Uploading..." : (_updateFileId.HasValue ? "Upload New Version" : "Upload All"))
        </button>
    }
</div>

@code {
    private const long MaxUploadSizeBytes = 250L * 1024L * 1024L;

    private List<IBrowserFile> _filesToUpload = new();
    private Dictionary<string, (string Text, string Class)> _statuses = new();
    private bool _isUploading;
    private Guid? _updateFileId;
    private string? _updateFileName;
    private (string Text, string Class)? _notice;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var update = GetQueryParam(uri, "update");
        if (Guid.TryParse(update, out var updateFileId))
        {
            _updateFileId = updateFileId;
            _updateFileName = GetQueryParam(uri, "fileName") ?? string.Empty;
        }
    }

    private static string? GetQueryParam(Uri uri, string name)
    {
        var query = uri.Query.TrimStart('?');
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length == 2 && parts[0].Equals(name, StringComparison.OrdinalIgnoreCase))
            {
                return Uri.UnescapeDataString(parts[1]);
            }
        }

        return null;
    }

    private void LoadFiles(InputFileChangeEventArgs e)
    {
        _filesToUpload = e.GetMultipleFiles().ToList();
        _statuses.Clear();
        _notice = null;
        foreach (var file in _filesToUpload)
        {
            var activityId = ActivityLog.Begin("Upload", file.Name, $"Queued {file.Size:N0} bytes for upload.");
            ActivityLog.Complete(activityId, "Upload", file.Name, "File is ready to upload.");
        }
    }

    private async Task UploadFilesAsync()
    {
        _isUploading = true;
        _notice = null;

        foreach (var file in _filesToUpload)
        {
            var activityId = ActivityLog.Begin("Upload", file.Name, "Opening browser file stream.");
            try
            {
                var fileId = _updateFileId ?? Guid.NewGuid();
                if (file.Size > MaxUploadSizeBytes)
                {
                    throw new InvalidOperationException(
                        $"Browser upload limit exceeded. FileSizeBytes: {file.Size}. MaxUploadSizeBytes: {MaxUploadSizeBytes}.");
                }

                using var stream = file.OpenReadStream(maxAllowedSize: MaxUploadSizeBytes);
                ActivityLog.Trace(activityId, "Upload", file.Name, "Sending file to API. Repository storage runs now; RAGS enrichment is queued as a background job.");
                var upload = await ApiClient.UploadAsync(
                    fileId,
                    file.Name,
                    file.ContentType,
                    stream,
                    file.Size,
                    existingFileId: _updateFileId);

                _statuses[file.Name] = upload switch
                {
                    { IsDuplicate: true, NoChange: true } => ("Already current - no changes", "bg-secondary"),
                    { IsDuplicate: true } => ("Duplicate - already exists", "bg-warning text-dark"),
                    { Uploaded: false } => ($"Upload failed: {SummarizeUploadError(upload.Error)}", "bg-danger"),
                    { IngestionJobId: not null } => ("Uploaded; ingestion queued", "bg-info text-dark"),
                    { RagsIngested: true, KnowledgeIndexed: true } => ("Uploaded + RAGS + knowledge indexed", "bg-success"),
                    { RagsIngested: true } => ("Uploaded + RAGS ingested", "bg-warning text-dark"),
                    { IngestionStatus: "UnsupportedType" } => ("Uploaded; RAGS skipped", "bg-secondary"),
                    _ => ("Uploaded; RAGS failed", "bg-warning text-dark")
                };

                if (upload.IsDuplicate)
                {
                    _notice = (upload.DuplicateMessage ?? "A file with identical content already exists.", "alert alert-warning");
                    ActivityLog.Warn(activityId, "Upload", file.Name, upload.DuplicateMessage ?? "Duplicate upload blocked; nothing was stored.");
                    continue;
                }

                if (!upload.Uploaded)
                {
                    ActivityLog.Fail(activityId, "Upload", file.Name, upload.Error ?? "Upload failed without API error detail.");
                    continue;
                }

                await RecentGraphContext.RecordDocumentAsync(fileId, file.Name);

                if (upload.IngestionJobId is Guid jobId)
                {
                    ActivityLog.Complete(activityId, "Upload", file.Name, $"Upload stored. Background ingestion job {jobId:N} is queued.");
                    var job = await ApiClient.GetIngestionJobAsync(jobId);
                    if (job is not null)
                    {
                        ActivityLog.UpsertJob(job);
                    }

                    _ = TrackIngestionAsync(file.Name, jobId);
                }
                else if (upload.RagsIngested && upload.KnowledgeIndexed)
                {
                    ActivityLog.Complete(activityId, "Upload", file.Name, $"Upload complete. RAGS and knowledge indexing completed with status {upload.IngestionStatus}.");
                }
                else if (upload.RagsIngested)
                {
                    ActivityLog.Warn(activityId, "Upload", file.Name, $"Upload complete. RAGS ingested, but knowledge indexing did not complete. Status: {upload.IngestionStatus}.");
                }
                else
                {
                    ActivityLog.Warn(activityId, "Upload", file.Name, $"Upload complete. RAGS/knowledge indexing skipped or failed. Status: {upload.IngestionStatus}. {upload.Error}");
                }
            }
            catch (Exception ex)
            {
                _statuses[file.Name] = ($"Error: {ex.Message}", "bg-danger");
                ActivityLog.Fail(activityId, "Upload", file.Name, $"{ex.GetType().Name}: {ex.Message}");
            }
        }

        _isUploading = false;
    }

    private readonly CancellationTokenSource _trackCts = new();

    private async Task TrackIngestionAsync(string fileName, Guid jobId)
    {
        var token = _trackCts.Token;
        for (var attempt = 0; attempt < 120 && !token.IsCancellationRequested; attempt++)
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(3), token).ConfigureAwait(false);
                var job = await ApiClient.GetIngestionJobAsync(jobId).ConfigureAwait(false);
                if (job is null)
                {
                    continue;
                }

                ActivityLog.UpsertJob(job);
                if (job.Status is "Succeeded" or "Failed" or "Cancelled")
                {
                    _statuses[fileName] = job.Status == "Succeeded"
                        ? ("Ready - fully ingested and searchable", "bg-success")
                        : ($"Ingestion {job.Status.ToLowerInvariant()}", "bg-danger");
                    await InvokeAsync(StateHasChanged).ConfigureAwait(false);
                    return;
                }
            }
            catch (OperationCanceledException)
            {
                return;
            }
            catch
            {
                // Transient polling errors are ignored; the Activity panel still shows job state.
            }
        }
    }

    public void Dispose()
    {
        _trackCts.Cancel();
        _trackCts.Dispose();
    }

    private static string SummarizeUploadError(string? error)
    {
        if (string.IsNullOrWhiteSpace(error))
        {
            return "no API detail";
        }

        const int maxLength = 96;
        return error.Length <= maxLength ? error : $"{error[..maxLength]}...";
    }
}


